+/// Share of a role's members that must carry a kind marker for the members to share it
+/// ([`has_kind_marker`]), and that a structural signature must cover for the role to be
+/// cohesive ([`cohesive`]).
+const KIND_MARKER_SHARE: f64 = 0.9;
+
+/// `useSession`, `use2FA`: the React hook naming the framework reserves (`use` and then
+/// an upper case letter or a digit).
+fn is_hook_name(name: &str) -> bool {
+    name.strip_prefix("use")
+        .and_then(|rest| rest.chars().next())
+        .is_some_and(|c| c.is_ascii_uppercase() || c.is_ascii_digit())
+}
+
+/// Whether the members of a TypeScript or JavaScript role share a structural kind
+/// marker, so a naming rule over them is about one kind of thing (M1, round 10). The
+/// markers are the role's own keys: a file kind (`*.handler`, `route`), an entry kind,
+/// a class variety, a member kind or a reserved export name. A role of components has
+/// one by its symbol kind (component versus hook), and a role of functions has one when
+/// [`KIND_MARKER_SHARE`] of them are hooks. Classes and exported values are not asked:
+/// the dev evidence is on functions only (round-10 plan, M1), and the same test on
+/// values would drop conventions labelled sound.
+fn has_kind_marker(role: &RoleSelector, population: &[usize], units: &[Unit]) -> bool {
+    if role.file != "*"
+        || role.entry != "-"
+        || role.variety.is_some()
+        || role.member_kind.is_some()
+        || role.export_name.is_some()
+        || role.kind != SymbolKind::Function
+    {
+        return true;
+    }
+    let hooks = population
+        .iter()
+        .filter(|&&m| matches!(units[m].view, View::Symbol(_, s) if is_hook_name(&s.name)))
+        .count();
+    !population.is_empty() && hooks as f64 >= KIND_MARKER_SHARE * population.len() as f64
+}
+
+/// Whether `name` is named after the file at `path`: its words end with the words of
+/// the file's stem (`registerUserRouter` in `user-router.ts`, `WorkspacePageClient` in
+/// `page-client.tsx`), or of its folder for an `index` file.
+fn named_after_file(path: &str, name: &str) -> bool {
+    let mut segs = path.rsplit('/');
+    let base = segs.next().unwrap_or(path);
+    let mut stem = base.split('.').next().unwrap_or(base);
+    if stem == "index" {
+        stem = segs.next().unwrap_or(stem);
+    }
+    let want = words(stem);
+    let have = words(name);
+    !want.is_empty() && have.ends_with(&want)
+}
+
+/// The primary export of its file: the default export, or an export named after the
+/// file ([`named_after_file`]).
+fn primary_export(f: &FileFacts, s: &Symbol) -> bool {
+    s.exported_as.iter().any(|e| e == "default") || named_after_file(&f.path, &s.name)
+}
+
+/// A secondary export of its file: not the primary export, in a file whose primary
+/// export ([`primary_export`]) is another symbol of the same kind (the helpers and
+/// part components beside a page client, a router or a provider). A member of a file
+/// with no primary export of its kind (a module of peer helpers) is no secondary one.
+fn secondary_export(f: &FileFacts, s: &Symbol) -> bool {
+    !primary_export(f, s)
+        && f.symbols.iter().any(|x| {
+            x.kind == s.kind
+                && x.name != s.name
+                && !x.exported_as.is_empty()
+                && primary_export(f, x)
+        })
+}
+
+/// Whether a TypeScript or JavaScript role is cohesive (M2, round 10): one structural
+/// signature covers [`KIND_MARKER_SHARE`] of its members. The signature is what a
+/// member is beyond the role's own keys (package, folder, file kind, entry kind,
+/// symbol kind and member kind, the same for every member): whether it is a secondary
+/// export of its file ([`secondary_export`]), and for a class, a base of its lineage or
+/// a class decorator (or none). A role whose members are not one kind of thing by that
+/// test proposes nothing, in any family: what most of a mix does is no convention of
+/// either part [STRICT: not mined, rather than mined per signature].
+///
+/// Python roles are split by framework lineage already (W1), an entry point's role is
+/// keyed by its entry kind, and file, model and package roles have no members to
+/// compare: they are cohesive.
+fn cohesive(role: &RoleSelector, members: &[usize], units: &[Unit], ctx: &RepoContext) -> bool {
+    if role.entry != "-"
+        || !matches!(
+            role.kind,
+            SymbolKind::Function | SymbolKind::Component | SymbolKind::Class | SymbolKind::Const
+        )
+        || python_units(members, units)
+        || members.is_empty()
+    {
+        return true;
+    }
+    // Members per signature part: (secondary export, lineage marker), where a class
+    // counts once under each base or decorator of its lineage, and a class with none
+    // (or a non-class) under `None`.
+    let mut by: BTreeMap<(bool, Option<String>), usize> = BTreeMap::new();
+    for &m in members {
+        let View::Symbol(f, s) = units[m].view else {
+            return true;
+        };
+        let secondary = secondary_export(f, s);
+        let mut marks: BTreeSet<String> = BTreeSet::new();
+        if role.kind == SymbolKind::Class && s.kind == SymbolKind::Class {
+            marks.extend(ctx.lineage(s));
+            marks.extend(class_decorators(s));
+        }
+        if marks.is_empty() {
+            *by.entry((secondary, None)).or_default() += 1;
+        }
+        for mark in marks {
+            *by.entry((secondary, Some(mark))).or_default() += 1;
+        }
+    }
+    let top = by.values().copied().max().unwrap_or(0);
+    top as f64 >= KIND_MARKER_SHARE * members.len() as f64
+}
+
 /// What mining proposed, by role and rule ([`carried_universal`]).
 type Proposed = BTreeSet<(RoleSelector, Rule)>;
 
