+//! Declared scopes of TypeScript/JavaScript configuration ([`drift_core::declared`]):
+//! tsconfig projects, ESLint global ignores and a published package's `files`.
+//!
+//! Every config is read as data, never run. Whatever cannot be read exactly (a JSONC
+//! error, an `extends` or a project reference that does not resolve to a file in the
+//! repository, a pattern Drift's globs do not read, a negation, ignores built at run
+//! time, a `files` entry that is not in the checkout) gives a scope with a note: it
+//! sets nothing apart in its directory (fail closed).
+
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+
+use drift_core::DeclaredScope;
+use drift_core::declared::{ESLINT, NPM_FILES, TSCONFIG, join, supported_glob};
+use drift_core::ingest::{Candidate, rel_posix};
+use oxc_allocator::Allocator;
+use oxc_ast::ast::*;
+use oxc_parser::Parser;
+use oxc_span::SourceType;
+
+use crate::resolve::{ModuleResolver, strip_jsonc};
+
+/// Extensions a tsconfig judges; with `allowJs` or `checkJs`, also [`JS_EXTS`].
+const TS_EXTS: &[&str] = &["ts", "tsx", "mts", "cts"];
+const JS_EXTS: &[&str] = &["js", "jsx", "mjs", "cjs"];
+/// How deep `extends` chains and project references are followed.
+const MAX_DEPTH: usize = 8;
+
+/// `tsconfig.json`, `tsconfig.app.json`, `tsconfig.build.json`, ...
+pub fn is_tsconfig(rel: &str) -> bool {
+    let name = rel.rsplit('/').next().unwrap_or(rel);
+    name.starts_with("tsconfig") && name.ends_with(".json")
+}
+
+fn dir_of(rel: &str) -> String {
+    rel.rsplit_once('/')
+        .map_or(String::new(), |(d, _)| d.to_string())
+}
+
+fn exts(js: bool) -> Vec<String> {
+    TS_EXTS
+        .iter()
+        .chain(if js { JS_EXTS } else { &[] })
+        .map(|e| e.to_string())
+        .collect()
+}
+
+fn noted(path: &str, source: &str, dir: &str, note: String) -> DeclaredScope {
+    DeclaredScope {
+        path: path.to_string(),
+        source: source.to_string(),
+        dir: dir.to_string(),
+        note,
+        ..Default::default()
+    }
+}
+
+/// Every declared scope of the walked config files. `present` is every walked file
+/// (repo-relative), for whether a package's `files` names what is in the checkout.
+pub fn scopes(
+    root: &Path,
+    resolver: &ModuleResolver,
+    config: &[Candidate],
+    present: &BTreeSet<String>,
+) -> Vec<DeclaredScope> {
+    let mut out = Vec::new();
+    for c in config {
+        let rel = c.rel_path.as_str();
+        if is_tsconfig(rel) {
+            out.extend(tsconfig_scopes(root, resolver, rel));
+        } else if crate::lint::config_tool(rel) == Some("eslint") {
+            out.extend(eslint_scope(rel, &c.abs_path));
+        }
+        if rel == "package.json" || rel.ends_with("/package.json") {
+            out.extend(npm_files_scope(root, rel, &c.abs_path, present));
+        }
+    }
+    out
+}
+
+// ---------- tsconfig ----------
+
+/// What one tsconfig project takes in: `files`, `include`, `exclude` and `allowJs` as
+/// TypeScript reads them through `extends`, patterns repo-relative.
+struct Project {
+    files: Vec<String>,
+    include: Vec<String>,
+    exclude: Vec<String>,
+    js: bool,
+    references: Vec<PathBuf>,
+}
+
+/// `file` and what it extends, nearest first (a later entry of an `extends` array
+/// overrides an earlier one, so it comes first), with each config's repo-relative dir.
+fn chain(
+    root: &Path,
+    resolver: &ModuleResolver,
+    file: &Path,
+    depth: usize,
+    out: &mut Vec<(String, serde_json::Value)>,
+) -> Result<(), String> {
+    // `../tsconfig.base.json` is named through its parent: the file itself decides.
+    let file = &std::fs::canonicalize(file)
+        .map_err(|_| "extends a config that could not be read".to_string())?;
+    let rel = rel_posix(root, file)
+        .ok_or_else(|| "extends a config outside the repository".to_string())?;
+    if depth > MAX_DEPTH || out.len() > 4 * MAX_DEPTH {
+        return Err(format!("extends more than {MAX_DEPTH} configs deep"));
+    }
+    let text = std::fs::read_to_string(file).map_err(|_| format!("{rel} could not be read"))?;
+    let json: serde_json::Value = serde_json::from_str(&strip_jsonc(&text))
+        .map_err(|_| format!("{rel} is not valid JSON"))?;
+    let dir = dir_of(&rel);
+    let parents: Vec<String> = match json.get("extends") {
+        None => vec![],
+        Some(serde_json::Value::String(s)) => vec![s.clone()],
+        Some(serde_json::Value::Array(a)) => a
+            .iter()
+            .map(|v| v.as_str().map(str::to_string))
+            .collect::<Option<_>>()
+            .ok_or_else(|| format!("{rel}: `extends` is not a list of strings"))?,
+        Some(_) => return Err(format!("{rel}: `extends` is not a string")),
+    };
+    out.push((dir, json));
+    let abs_dir = file.parent().unwrap_or(root);
+    for p in parents.iter().rev() {
+        let base = resolver
+            .tsconfig_extends(abs_dir, p)
+            .filter(|b| b.is_file())
+            .ok_or_else(|| format!("{rel} extends `{p}`, which is not a file in the repository"))?;
+        chain(root, resolver, &base, depth + 1, out)?;
+    }
+    Ok(())
+}
+
+/// A tsconfig `include` or `exclude` entry, repo-relative. An `include` entry whose
+/// last segment has no wildcard and no extension names a directory.
+fn ts_pattern(dir: &str, p: &str, include: bool) -> Result<String, String> {
+    let p = p.trim_end_matches('/');
+    let joined = join(dir, p).ok_or_else(|| format!("`{p}` leaves the repository"))?;
+    // The repository root itself: everything below it for `include`.
+    if joined.is_empty() {
+        return if include {
+            Ok("**".to_string())
+        } else {
+            Err("excludes the whole project".to_string())
+        };
+    }
+    if !supported_glob(&joined) {
+        return Err(format!("`{p}` is a pattern Drift does not read"));
+    }
+    let last = joined.rsplit('/').next().unwrap_or(&joined);
+    Ok(if include && !last.contains(['*', '?', '.']) {
+        if joined.is_empty() {
+            "**".to_string()
+        } else {
+            format!("{joined}/**")
+        }
+    } else {
+        joined
+    })
+}
+
+fn string_list(v: &serde_json::Value, key: &str) -> Result<Vec<String>, String> {
+    v.as_array()
+        .and_then(|a| a.iter().map(|x| x.as_str().map(str::to_string)).collect())
+        .ok_or_else(|| format!("`{key}` is not a list of strings"))
+}
+
+fn project(root: &Path, resolver: &ModuleResolver, file: &Path) -> Result<Project, String> {
+    let mut configs = Vec::new();
+    chain(root, resolver, file, 0, &mut configs)?;
+    let leaf_dir = configs[0].0.clone();
+    // The nearest config that sets a key decides it, its paths relative to itself.
+    let first = |key: &str| configs.iter().find_map(|(d, j)| j.get(key).map(|v| (d, v)));
+    let mut files = Vec::new();
+    if let Some((d, v)) = first("files") {
+        for f in string_list(v, "files")? {
+            files.push(join(d, &f).ok_or_else(|| format!("`{f}` leaves the repository"))?);
+        }
+    }
+    let mut include = Vec::new();
+    match first("include") {
+        Some((d, v)) => {
+            for p in string_list(v, "include")? {
+                include.push(ts_pattern(d, &p, true)?);
+            }
+        }
+        // No `files` and no `include`: everything below the config.
+        None if first("files").is_none() => include.push(ts_pattern(&leaf_dir, "", true)?),
+        None => {}
+    }
+    let mut exclude = Vec::new();
+    if let Some((d, v)) = first("exclude") {
+        for p in string_list(v, "exclude")? {
+            exclude.push(ts_pattern(d, &p, false)?);
+        }
+    }
+    let js = ["allowJs", "checkJs"].iter().any(|k| {
+        configs
+            .iter()
+            .find_map(|(_, j)| j.get("compilerOptions")?.get(*k)?.as_bool())
+            .unwrap_or(false)
+    });
+    // References are not inherited: the config's own.
+    let abs_dir = file.parent().unwrap_or(root);
+    let mut references = Vec::new();
+    if let Some(refs) = configs[0].1.get("references") {
+        let refs = refs
+            .as_array()
+            .ok_or_else(|| "`references` is not a list".to_string())?;
+        for r in refs {
+            let p = r
+                .get("path")
+                .and_then(|p| p.as_str())
+                .ok_or_else(|| "a reference has no `path`".to_string())?;
+            let target = abs_dir.join(p);
+            let target = if target.is_dir() {
+                target.join("tsconfig.json")
+            } else {
+                target
+            };
+            match std::fs::canonicalize(&target) {
+                Ok(t) if t.is_file() && rel_posix(root, &t).is_some() => references.push(t),
+                _ => {
+                    return Err(format!(
+                        "references `{p}`, which is not a config in the repository"
+                    ));
+                }
+            }
+        }
+    }
+    Ok(Project {
+        files,
+        include,
+        exclude,
+        js,
+        references,
+    })
+}
+
+/// The scopes of the tsconfig `rel`: its own project and every project it references
+/// (to any depth), all governing its directory.
+fn tsconfig_scopes(root: &Path, resolver: &ModuleResolver, rel: &str) -> Vec<DeclaredScope> {
+    let dir = dir_of(rel);
+    let mut out = Vec::new();
+    let mut seen = BTreeSet::new();
+    let mut pending = vec![(
+        std::fs::canonicalize(root.join(rel)).unwrap_or_else(|_| root.join(rel)),
+        0usize,
+    )];
+    while let Some((file, depth)) = pending.pop() {
+        // Every queued file is canonical and in the repository (`project` checks
+        // references): a path it cannot name is a reference not read.
+        let Some(path) = rel_posix(root, &file) else {
+            out.push(noted(
+                rel,
+                TSCONFIG,
+                &dir,
+                "references a config outside the repository".into(),
+            ));
+            continue;
+        };
+        if !seen.insert(path.clone()) {
+            continue;
+        }
+        match project(root, resolver, &file) {
+            Ok(p) if depth <= MAX_DEPTH => {
+                pending.extend(p.references.iter().map(|r| (r.clone(), depth + 1)));
+                out.push(DeclaredScope {
+                    path,
+                    source: TSCONFIG.into(),
+                    dir: dir.clone(),
+                    exts: exts(p.js),
+                    files: p.files,
+                    include: p.include,
+                    exclude: p.exclude,
+                    note: String::new(),
+                });
+            }
+            Ok(_) => out.push(noted(
+                &path,
+                TSCONFIG,
+                &dir,
+                "references nested too deep".into(),
+            )),
+            Err(note) => out.push(noted(&path, TSCONFIG, &dir, note)),
+        }
+    }
+    out
+}
+
+// ---------- ESLint ----------
+
+/// An ignore pattern, repo-relative: gitignore-style for legacy `ignorePatterns` (a
+/// pattern without a slash matches at any depth), relative to the config's directory
+/// for flat-config `ignores`.
+fn ignore_pattern(dir: &str, p: &str, gitignore: bool) -> Result<String, String> {
+    if p.starts_with('!') {
+        return Err(format!("`{p}` un-ignores files"));
+    }
+    let p = p.trim_end_matches('/');
+    let anchored = p.starts_with('/') || p.contains('/');
+    let p = p.trim_start_matches('/');
+    let p = if gitignore && !anchored && !p.starts_with("**") {
+        format!("**/{p}")
+    } else {
+        p.to_string()
+    };
+    let joined = join(dir, &p).ok_or_else(|| format!("`{p}` leaves the repository"))?;
+    if !supported_glob(&joined) {
+        return Err(format!("`{p}` is a pattern Drift does not read"));
+    }
+    Ok(joined)
+}
+
+fn eslint_scope(rel: &str, abs: &Path) -> Option<DeclaredScope> {
+    let dir = dir_of(rel);
+    let file = rel.rsplit('/').next().unwrap_or(rel);
+    let Ok(text) = std::fs::read_to_string(abs) else {
+        return Some(noted(rel, ESLINT, &dir, "could not be read".into()));
+    };
+    let read: Result<(Vec<String>, bool), String> = if file == "package.json" {
+        let v = serde_json::from_str::<serde_json::Value>(&text).ok()?;
+        let e = v.get("eslintConfig")?;
+        json_ignore_patterns(e).map(|p| (p, true))
+    } else if file.ends_with("js") || file.ends_with("ts") {
+        let legacy = file.starts_with(".eslintrc");
+        js_ignores(rel, &text, legacy).map(|p| (p, legacy))
+    } else {
+        crate::lint::parse_jsonc(&text)
+            .ok_or_else(|| "is not JSON Drift reads".to_string())
+            .and_then(|v| json_ignore_patterns(&v))
+            .map(|p| (p, true))
+    };
+    let scope = read.and_then(|(patterns, gitignore)| {
+        patterns
+            .iter()
+            .map(|p| ignore_pattern(&dir, p, gitignore))
+            .collect::<Result<Vec<_>, _>>()
+    });
+    Some(match scope {
+        Ok(exclude) => DeclaredScope {
+            path: rel.to_string(),
+            source: ESLINT.into(),
+            dir: dir.clone(),
+            exts: exts(true),
+            include: vec![if dir.is_empty() {
+                "**".into()
+            } else {
+                format!("{dir}/**")
+            }],
+            exclude,
+            ..Default::default()
+        },
+        Err(note) => noted(rel, ESLINT, &dir, note),
+    })
+}
+
+fn json_ignore_patterns(v: &serde_json::Value) -> Result<Vec<String>, String> {
+    match v.get("ignorePatterns") {
+        None => Ok(vec![]),
+        Some(serde_json::Value::String(s)) => Ok(vec![s.clone()]),
+        Some(p) => string_list(p, "ignorePatterns"),
+    }
+}
+
+/// The global ignores of a JavaScript config, read syntactically: legacy
+/// `module.exports = { ignorePatterns }`, or flat-config blocks whose only keys are
+/// `ignores` (and `name`) and `globalIgnores([...])` calls, through arrays, spreads,
+/// call arguments and top-level constants of what the file exports. A block imported
+/// from another module is not seen (its ignores could only set more apart).
+fn js_ignores(rel: &str, text: &str, legacy: bool) -> Result<Vec<String>, String> {
+    let dialect = drift_core::speculation::Dialect::of_path(rel);
+    if drift_core::speculation::too_costly(text, dialect) {
+        return Err("too costly to parse".into());
+    }
+    drift_core::stack::with_stack_for(text.len(), || {
+        crate::arena::with_arena(text.len(), |allocator| {
+            js_ignores_in(allocator, rel, text, legacy)
+        })
+        .unwrap_or_else(|_| Err("over the parse budget".into()))
+    })
+    .unwrap_or_else(|_| Err("no stack to parse it on".into()))
+}
+
+fn js_ignores_in(
+    allocator: &Allocator,
+    rel: &str,
+    text: &str,
+    legacy: bool,
+) -> Result<Vec<String>, String> {
+    let source_type = SourceType::from_path(rel).unwrap_or_else(|_| SourceType::mjs());
+    let ret = Parser::new(allocator, text, source_type).parse();
+    if ret.fatal_error || !ret.diagnostics.is_empty() {
+        return Err("has syntax errors".into());
+    }
+    let mut v = Ignores {
+        consts: Default::default(),
+        out: Vec::new(),
+        visits: 0,
+    };
+    let mut exported: Vec<&Expression> = Vec::new();
+    for stmt in &ret.program.body {
+        match stmt {
+            Statement::VariableDeclaration(d) => v.declare(d),
+            Statement::ExportDeclaration(e) => {
+                if let Declaration::VariableDeclaration(d) = &e.declaration {
+                    v.declare(d);
+                }
+            }
+            Statement::ExportDefaultDeclaration(e) => {
+                if let Some(x) = e.declaration.as_expression() {
+                    exported.push(x);
+                }
+            }
+            Statement::ExpressionStatement(es) => {
+                if let Expression::AssignmentExpression(a) = &es.expression
+                    && let AssignmentTarget::StaticMemberExpression(m) = &a.left
+                    && m.property.name == "exports"
+                    && matches!(&m.object, Expression::Identifier(id) if id.name == "module")
+                {
+                    exported.push(&a.right);
+                }
+            }
+            _ => {}
+        }
+    }
+    for e in exported {
+        if legacy {
+            v.legacy(e, 0)?;
+        } else {
+            v.flat(e, 0)?;
+        }
+    }
+    Ok(v.out)
+}
+
+const MAX_VISITS: usize = 10_000;
+
+struct Ignores<'b, 'a> {
+    consts: std::collections::BTreeMap<String, &'b Expression<'a>>,
+    out: Vec<String>,
+    visits: usize,
+}
+
+fn unwrap_ts<'b, 'a>(mut e: &'b Expression<'a>) -> &'b Expression<'a> {
+    loop {
+        e = match e {
+            Expression::ParenthesizedExpression(p) => &p.expression,
+            Expression::TSAsExpression(x) => &x.expression,
+            Expression::TSSatisfiesExpression(x) => &x.expression,
+            _ => return e,
+        };
+    }
+}
+
+fn key_of(p: &ObjectProperty) -> Option<String> {
+    if p.computed {
+        return match &p.key {
+            PropertyKey::StringLiteral(s) => Some(s.value.display().to_string()),
+            _ => None,
+        };
+    }
+    p.key
+        .static_name()
+        .and_then(|n| n.as_str().map(str::to_string))
+}
+
+impl<'b, 'a> Ignores<'b, 'a> {
+    fn declare(&mut self, d: &'b VariableDeclaration<'a>) {
+        for decl in &d.declarations {
+            if let (BindingPattern::BindingIdentifier(id), Some(init)) = (&decl.id, &decl.init) {
+                self.consts.insert(id.name.to_string(), init);
+            }
+        }
+    }
+
+    fn budget(&mut self, depth: usize) -> Result<(), String> {
+        self.visits += 1;
+        if depth > 12 || self.visits > MAX_VISITS {
+            return Err("nested too deep to read".into());
+        }
+        Ok(())
+    }
+
+    /// The strings of an ignore list: literals, or a constant naming such a list.
+    fn strings(&mut self, e: &'b Expression<'a>, depth: usize) -> Result<(), String> {
+        self.budget(depth)?;
+        match unwrap_ts(e) {
+            Expression::StringLiteral(s) => self.out.push(s.value.display().to_string()),
+            Expression::TemplateLiteral(t) if t.expressions.is_empty() => {
+                self.out
+                    .push(t.quasis.iter().map(|q| q.value.raw.to_string()).collect());
+            }
+            Expression::ArrayExpression(a) => {
+                for el in &a.elements {
+                    match el {
+                        ArrayExpressionElement::SpreadElement(sp) => {
+                            self.strings(&sp.argument, depth + 1)?
+                        }
+                        other => match other.as_expression() {
+                            Some(x) => self.strings(x, depth + 1)?,
+                            None => return Err("an ignore list has a hole".into()),
+                        },
+                    }
+                }
+            }
+            Expression::Identifier(id) => match self.consts.get(id.name.as_str()).copied() {
+                Some(init) => self.strings(init, depth + 1)?,
+                None => return Err(format!("ignores `{}`, built elsewhere", id.name)),
+            },
+            _ => return Err("ignores built at run time".into()),
+        }
+        Ok(())
+    }
+
+    fn legacy(&mut self, e: &'b Expression<'a>, depth: usize) -> Result<(), String> {
+        self.budget(depth)?;
+        match unwrap_ts(e) {
+            Expression::ObjectExpression(o) => {
+                for p in &o.properties {
+                    match p {
+                        ObjectPropertyKind::ObjectProperty(p)
+                            if key_of(p).as_deref() == Some("ignorePatterns") =>
+                        {
+                            self.strings(&p.value, depth + 1)?;
+                        }
+                        ObjectPropertyKind::ObjectProperty(_) => {}
+                        ObjectPropertyKind::SpreadProperty(_) => {
+                            return Err("spreads a config built elsewhere".into());
+                        }
+                    }
+                }
+                Ok(())
+            }
+            Expression::Identifier(id) => match self.consts.get(id.name.as_str()).copied() {
+                Some(init) => self.legacy(init, depth + 1),
+                None => Err(format!("exports `{}`, built elsewhere", id.name)),
+            },
+            _ => Err("exports a config built at run time".into()),
+        }
+    }
+
+    fn flat(&mut self, e: &'b Expression<'a>, depth: usize) -> Result<(), String> {
+        self.budget(depth)?;
+        match unwrap_ts(e) {
+            Expression::ArrayExpression(a) => {
+                for el in &a.elements {
+                    match el {
+                        ArrayExpressionElement::SpreadElement(sp) => {
+                            self.flat(&sp.argument, depth + 1)?
+                        }
+                        other => {
+                            if let Some(x) = other.as_expression() {
+                                self.flat(x, depth + 1)?;
+                            }
+                        }
+                    }
+                }
+            }
+            Expression::CallExpression(c) => {
+                let callee = match &c.callee {
+                    Expression::Identifier(id) => Some(id.name.as_str()),
+                    Expression::StaticMemberExpression(m) => Some(m.property.name.as_str()),
+                    _ => None,
+                };
+                if callee == Some("globalIgnores") {
+                    match c.arguments.first().and_then(|a| a.as_expression()) {
+                        Some(x) => self.strings(x, depth + 1)?,
+                        None => return Err("`globalIgnores` of a list built at run time".into()),
+                    }
+                    return Ok(());
+                }
+                // `defineConfig(...)`, `tseslint.config(...)`: their arguments are blocks.
+                for a in &c.arguments {
+                    match a {
+                        Argument::SpreadElement(sp) => self.flat(&sp.argument, depth + 1)?,
+                        other => {
+                            if let Some(x) = other.as_expression() {
+                                self.flat(x, depth + 1)?;
+                            }
+                        }
+                    }
+                }
+            }
+            Expression::ObjectExpression(o) => {
+                // A block whose only keys are `ignores` (and `name`) ignores globally.
+                let keys: Option<Vec<String>> = o
+                    .properties
+                    .iter()
+                    .map(|p| match p {
+                        ObjectPropertyKind::ObjectProperty(p) => key_of(p),
+                        ObjectPropertyKind::SpreadProperty(_) => None,
+                    })
+                    .collect();
+                if let Some(keys) = &keys
+                    && keys.iter().any(|k| k == "ignores")
+                    && keys.iter().all(|k| k == "ignores" || k == "name")
+                {
+                    for p in &o.properties {
+                        if let ObjectPropertyKind::ObjectProperty(p) = p
+                            && key_of(p).as_deref() == Some("ignores")
+                        {
+                            self.strings(&p.value, depth + 1)?;
+                        }
+                    }
+                } else if keys.is_none()
+                    && o.properties.iter().any(|p| matches!(p, ObjectPropertyKind::ObjectProperty(p) if key_of(p).as_deref() == Some("ignores")))
+                {
+                    // `{ ...shared, ignores }`: whether it is global depends on what is spread.
+                    return Err("a block with `ignores` spreads a config built elsewhere".into());
+                }
+            }
+            Expression::Identifier(id) => {
+                if let Some(init) = self.consts.get(id.name.as_str()).copied() {
+                    self.flat(init, depth + 1)?;
+                }
+            }
+            _ => {}
+        }
+        Ok(())
+    }
+}
