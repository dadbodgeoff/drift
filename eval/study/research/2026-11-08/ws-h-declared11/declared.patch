+// ---------- package.json `files` ----------
+
+/// The `files` of a published package (`private` not `true`): what it publishes. Read
+/// only when every entry names something in the checkout: a package that publishes a
+/// build output (`dist`) publishes sources Drift cannot map entry by entry.
+fn npm_files_scope(
+    root: &Path,
+    rel: &str,
+    abs: &Path,
+    present: &BTreeSet<String>,
+) -> Option<DeclaredScope> {
+    let dir = dir_of(rel);
+    let Some(v) = std::fs::read_to_string(abs)
+        .ok()
+        .and_then(|t| serde_json::from_str::<serde_json::Value>(&t).ok())
+    else {
+        return Some(noted(rel, NPM_FILES, &dir, "is not valid JSON".into()));
+    };
+    if v.get("private").and_then(|p| p.as_bool()) == Some(true) {
+        return None;
+    }
+    let files = v.get("files")?;
+    let read = (|| -> Result<DeclaredScope, String> {
+        let entries = string_list(files, "files")?;
+        let mut include = Vec::new();
+        for e in &entries {
+            let g = ignore_pattern(&dir, e.trim_start_matches("./"), true)?;
+            let below = format!("{g}/**");
+            let literal = !e.contains(['*', '?', '{']);
+            let exists = if literal {
+                join(&dir, e.trim_start_matches('/')).is_some_and(|p| root.join(p).exists())
+            } else {
+                present.iter().any(|p| {
+                    drift_core::declared::glob_match(&g, p)
+                        || drift_core::declared::glob_match(&below, p)
+                })
+            };
+            if !exists {
+                return Err(format!(
+                    "`files` names `{e}`, which is not in the checkout (a build output)"
+                ));
+            }
+            include.push(g);
+            include.push(below);
+        }
+        // What npm always publishes: the manifest's `main` and `bin`.
+        let mut always = Vec::new();
+        let mut named = Vec::new();
+        if let Some(m) = v.get("main").and_then(|m| m.as_str()) {
+            named.push(m.to_string());
+        }
+        match v.get("bin") {
+            Some(serde_json::Value::String(b)) => named.push(b.clone()),
+            Some(serde_json::Value::Object(o)) => {
+                named.extend(o.values().filter_map(|b| b.as_str().map(str::to_string)));
+            }
+            _ => {}
+        }
+        for n in named {
+            if let Some(p) = join(&dir, &n) {
+                always.push(p);
+            }
+        }
+        Ok(DeclaredScope {
+            path: rel.to_string(),
+            source: NPM_FILES.into(),
+            dir: dir.clone(),
+            exts: exts(true),
+            files: always,
+            include,
+            ..Default::default()
+        })
+    })();
+    Some(read.unwrap_or_else(|note| noted(rel, NPM_FILES, &dir, note)))
+}
