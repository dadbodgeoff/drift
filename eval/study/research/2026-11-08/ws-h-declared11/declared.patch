+            ..Default::default()
+        };
+        repo.files[4].entry_points = vec![EntryPoint {
+            symbol: "GET".into(),
+            kind: "http".into(),
+            method: None,
+            route: None,
+            adapter: "nextjs".into(),
+        }];
+        repo.files[0].discovers = vec!["tools/f*.ts".into()];
+        let apart = set_apart(&repo);
+        assert_eq!(
+            apart.keys().map(String::as_str).collect::<Vec<_>>(),
