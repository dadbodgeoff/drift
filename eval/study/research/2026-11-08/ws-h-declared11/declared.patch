+#[cfg(test)]
+mod tests {
+    use super::*;
+    use drift_core::declared::pattern_out;
+
+    fn write(root: &Path, rel: &str, body: &str) {
+        let p = root.join(rel);
+        std::fs::create_dir_all(p.parent().unwrap()).unwrap();
+        std::fs::write(p, body).unwrap();
+    }
+
+    fn scopes_of(root: &Path, rels: &[&str]) -> Vec<DeclaredScope> {
+        let root = root.canonicalize().unwrap();
+        let resolver = ModuleResolver::new(&root, Default::default());
+        let config: Vec<Candidate> = rels
+            .iter()
+            .map(|r| Candidate {
+                rel_path: r.to_string(),
+                abs_path: root.join(r),
+                stamp: Default::default(),
+            })
+            .collect();
+        let present = rels.iter().map(|r| r.to_string()).collect();
+        let mut s = scopes(&root, &resolver, &config, &present);
+        s.sort();
+        s
+    }
+
+    #[test]
+    fn tsconfig_include_exclude_extends_and_references() {
+        let t = tempfile::tempdir().unwrap();
+        let r = t.path();
+        write(
+            r,
+            "tsconfig.base.json",
+            r#"{ "include": ["src"], "exclude": ["src/gen"] }"#,
+        );
+        write(
+            r,
+            "tsconfig.json",
+            "// solution\n{ \"files\": [], \"references\": [{ \"path\": \"./tsconfig.app.json\" }, { \"path\": \"./tools\" }] }",
+        );
+        write(
+            r,
+            "tsconfig.app.json",
+            r#"{ "extends": "./tsconfig.base.json", "compilerOptions": { "allowJs": true } }"#,
+        );
+        write(r, "tools/tsconfig.json", r#"{ "include": ["*.ts"] }"#);
+        let s = scopes_of(
+            r,
+            &[
+                "tsconfig.base.json",
+                "tsconfig.json",
+                "tsconfig.app.json",
+                "tools/tsconfig.json",
+            ],
+        );
+        let out = |p: &str| pattern_out(&s, p, "").map(|s| s.path.clone());
+        assert_eq!(out("src/a.ts"), None);
+        // Out by every project of the root directory (the first is reported).
+        assert!(out("src/gen/a.ts").is_some());
+        assert!(out("vite.config.ts").is_some());
+        assert_eq!(
+            out("vite.config.cjs"),
+            None,
+            "the solution config does not judge JS"
+        );
+        // tools/ has a tsconfig of its own, which takes its top-level files in.
+        assert_eq!(out("tools/a.ts"), None);
+        assert_eq!(
+            out("tools/deep/a.ts").as_deref(),
+            Some("tools/tsconfig.json")
+        );
+    }
+
+    /// `extends` and `references` through a parent directory are read, never dropped.
+    #[test]
+    fn parent_directory_extends_and_references() {
+        let t = tempfile::tempdir().unwrap();
+        let r = t.path();
+        write(r, "configs/base.json", r#"{ "include": ["../app/src"] }"#);
+        write(
+            r,
+            "app/tsconfig.json",
+            r#"{ "extends": "../configs/base.json", "references": [{ "path": "../app/tools" }] }"#,
+        );
+        write(
+            r,
+            "app/tools/tsconfig.json",
+            r#"{ "include": ["../scripts"] }"#,
+        );
+        let s = scopes_of(r, &["app/tsconfig.json", "app/tools/tsconfig.json"]);
+        assert!(s.iter().all(|s| s.note.is_empty()), "{s:#?}");
+        let out = |p: &str| pattern_out(&s, p, "app").is_some();
+        assert!(!out("app/src/a.ts"));
+        assert!(
+            !out("app/scripts/a.ts"),
+            "taken in by the referenced project"
+        );
+        assert!(out("app/vite.config.ts"));
+    }
+
+    /// A root tsconfig with neither `files` nor `include` takes in everything.
+    #[test]
+    fn a_root_tsconfig_without_include_takes_everything_in() {
+        let t = tempfile::tempdir().unwrap();
+        let r = t.path();
+        write(
+            r,
+            "tsconfig.json",
+            r#"{ "compilerOptions": { "strict": true }, "exclude": ["gen"] }"#,
+        );
+        let s = scopes_of(r, &["tsconfig.json"]);
+        assert!(s.iter().all(|s| s.note.is_empty()), "{s:#?}");
+        assert!(pattern_out(&s, "scripts/a.ts", "").is_none());
+        assert!(pattern_out(&s, "gen/a.ts", "").is_some());
+    }
+
+    #[test]
+    fn an_unreadable_tsconfig_sets_nothing_apart() {
+        let t = tempfile::tempdir().unwrap();
+        let r = t.path();
+        write(
+            r,
+            "tsconfig.json",
+            r#"{ "extends": "@tsconfig/node20/tsconfig.json", "include": ["src"] }"#,
+        );
+        write(r, "a/tsconfig.json", r#"{ "include": ["src"], }  oops"#);
+        write(r, "b/tsconfig.json", r#"{ "include": ["src/[ab]*.ts"] }"#);
+        let s = scopes_of(r, &["tsconfig.json", "a/tsconfig.json", "b/tsconfig.json"]);
+        assert!(s.iter().all(|s| !s.note.is_empty()), "{s:#?}");
+        assert!(pattern_out(&s, "scripts/x.ts", "").is_none());
+        assert!(pattern_out(&s, "a/scripts/x.ts", "").is_none());
+        assert!(pattern_out(&s, "b/x.ts", "").is_none());
+    }
+
+    #[test]
+    fn eslint_global_ignores_not_rule_overrides() {
+        let t = tempfile::tempdir().unwrap();
+        let r = t.path();
+        write(
+            r,
+            "eslint.config.mjs",
+            r#"import js from "@eslint/js";
+const generated = ["src/gen/**"];
+export default defineConfig([
+  globalIgnores(["dist/", "**/*.config.cjs"]),
+  { ignores: generated, name: "gen" },
+  { files: ["scripts/**"], ignores: ["scripts/keep.ts"], rules: { "no-console": "off" } },
+  ...js.configs.recommended,
+]);"#,
+        );
+        write(
+            r,
+            "web/.eslintrc.json",
+            r#"{ "root": true, "ignorePatterns": ["legacy", "/top.ts"] }"#,
+        );
+        write(
+            r,
+            "bad/eslint.config.js",
+            r#"export default [{ ignores: ["dist", ...shared] }];"#,
+        );
+        write(
+            r,
+            "neg/.eslintrc.json",
+            r#"{ "ignorePatterns": ["gen", "!gen/keep.ts"] }"#,
+        );
+        let s = scopes_of(
+            r,
+            &[
+                "eslint.config.mjs",
+                "web/.eslintrc.json",
+                "bad/eslint.config.js",
+                "neg/.eslintrc.json",
+            ],
+        );
+        let out = |p: &str| pattern_out(&s, p, "").is_some();
+        assert!(out("src/gen/a.ts"));
+        assert!(out("apps/electron-builder.config.cjs"));
+        assert!(out("dist/x.js"));
+        assert!(
+            !out("scripts/keep.ts"),
+            "ignores in a block with `files` are not global"
+        );
+        assert!(!out("src/a.ts"));
+        // The nearest config governs: web's own patterns, gitignore-style.
+        assert!(out("web/a/legacy/x.ts"));
+        assert!(out("web/top.ts"));
+        assert!(!out("web/a/top.ts"));
+        assert!(!out("web/src/gen/a.ts"));
+        // Unreadable ignores and negations set nothing apart.
+        assert!(!out("bad/dist/x.js"));
+        assert!(!out("neg/gen/x.ts"));
+    }
+
+    #[test]
+    fn published_files_only_when_in_the_checkout() {
+        let t = tempfile::tempdir().unwrap();
+        let r = t.path();
+        write(
+            r,
+            "lib/package.json",
+            r#"{ "name": "lib", "files": ["src", "index.js"], "bin": "cli.js" }"#,
+        );
+        write(r, "lib/src/a.ts", "");
+        write(r, "lib/index.js", "");
+        write(
+            r,
+            "built/package.json",
+            r#"{ "name": "built", "files": ["dist"] }"#,
+        );
+        write(
+            r,
+            "app/package.json",
+            r#"{ "private": true, "files": ["src"] }"#,
+        );
+        let s = scopes_of(
+            r,
+            &["lib/package.json", "built/package.json", "app/package.json"],
+        );
+        let out = |p: &str, pkg: &str| pattern_out(&s, p, pkg).is_some();
+        assert!(!out("lib/src/x/a.ts", "lib"));
+        assert!(!out("lib/cli.js", "lib"));
+        assert!(out("lib/scripts/release.ts", "lib"));
+        assert!(
+            !out("built/scripts/release.ts", "built"),
+            "`dist` is not in the checkout"
+        );
+        assert!(
+            !out("app/scripts/x.ts", "app"),
+            "a private package publishes nothing"
+        );
+        assert!(
+            s.iter()
+                .any(|s| s.path == "built/package.json" && !s.note.is_empty())
+        );
+    }
+}
