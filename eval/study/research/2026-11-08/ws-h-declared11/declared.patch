new file mode 100644
index 00000000..5d2bdfb9
--- /dev/null
+++ b/crates/drift-mine/tests/declared.rs
@@ -0,0 +1,203 @@
+//! Declared scope ([`drift_core::declared`]): a member the repository's own
+//! configuration leaves out of its application graph is in no role, so support,
+//! outliers and the Wilson bound are counted without it, and `drift check` agrees. A
+//! config that was not read, an entry point and a file reached from a kept file are
+//! never set apart; a convention written before declared scopes (`selector_version` 3)
+//! keeps checking the member.
+//!
+//! The fixtures are handler folders, not any dev repository's code.
+
+use drift_core::{
+    DeclaredScope, EntryPoint, FileFacts, Import, RepoFacts, Symbol, SymbolKind, Wrap, WrapKind,
+};
+use drift_mine::check::{Scope, check};
+use drift_mine::mine::{Candidate, MineOptions, Rule, mine_unshown as mine};
+use drift_mine::policy::{ConventionsFile, Lock, SELECTOR_VERSION, Status};
+
+const AUTH: &str = "web/lib/auth.ts#withAuth";
+
+fn file(path: &str, package: &str, symbols: Vec<Symbol>) -> FileFacts {
+    FileFacts {
+        path: path.into(),
+        package: package.into(),
+        lang: "ts".into(),
+        parse_ok: true,
+        symbols,
+        ..Default::default()
+    }
+}
+
+fn func(name: &str, wrapped: bool) -> Symbol {
+    Symbol {
+        name: name.into(),
+        kind: SymbolKind::Function,
+        exported_as: vec![name.into()],
+        line: 3,
+        wraps: if wrapped {
+            vec![Wrap {
+                wrapper: AUTH.into(),
+                kind: WrapKind::Call,
+            }]
+        } else {
+            vec![]
+        },
+        ..Default::default()
+    }
+}
+
+/// 30 handlers wrapped by `withAuth`, two that are not (`odd.ts`, `seed.ts`), the
+/// wrapper, 60 plain functions elsewhere (lift), and `scopes`; `edit` changes the files.
+fn repo(scopes: Vec<DeclaredScope>, edit: impl FnOnce(&mut Vec<FileFacts>)) -> RepoFacts {
+    let mut files: Vec<FileFacts> = (0..30)
+        .map(|i| {
+            file(
+                &format!("web/handlers/h{i}.ts"),
+                "web",
+                vec![func(&format!("h{i}"), true)],
+            )
+        })
+        .collect();
+    files.push(file("web/handlers/odd.ts", "web", vec![func("odd", false)]));
+    files.push(file(
+        "web/handlers/seed.ts",
+        "web",
+        vec![func("seed", false)],
+    ));
+    files.push(file(
+        "web/lib/auth.ts",
+        "web",
+        vec![func("withAuth", false)],
+    ));
+    for i in 0..60 {
+        files.push(file(
+            &format!("api/src/u{i}.ts"),
+            "api",
+            vec![func(&format!("u{i}"), false)],
+        ));
+    }
+    edit(&mut files);
+    let mut r = RepoFacts {
+        files,
+        declared: scopes,
+        ..Default::default()
+    };
+    r.normalize();
+    r
+}
+
+/// `web/tsconfig.json`: every file of `web` but `handlers/seed.ts`.
+fn tsconfig(note: &str) -> DeclaredScope {
+    DeclaredScope {
+        path: "web/tsconfig.json".into(),
+        source: drift_core::declared::TSCONFIG.into(),
+        dir: "web".into(),
+        exts: vec!["ts".into(), "tsx".into()],
+        include: vec!["web/**".into()],
+        exclude: vec!["web/handlers/seed.ts".into()],
+        note: note.into(),
+        ..Default::default()
+    }
+}
+
+fn candidate(r: &RepoFacts) -> Candidate {
+    mine(r, &MineOptions { max_per_repo: 200 })
+        .candidates
+        .into_iter()
+        .find(|c| {
+            c.rule
+                == Rule::WrappedBy {
+                    kind: WrapKind::Call,
+                    any_of: vec![AUTH.into()],
+                }
+        })
+        .expect("handlers wrap withAuth")
+}
+
+fn outliers(c: &Candidate) -> Vec<String> {
+    c.outliers.iter().map(|o| o.path.clone()).collect()
+}
+
+fn violations(r: &RepoFacts, c: &Candidate, selector_version: u32) -> Vec<String> {
+    let kinds = mine(r, &MineOptions { max_per_repo: 200 }).kinds;
+    let mut p = ConventionsFile::merge(None, "test", kinds, std::slice::from_ref(c));
+    p.conventions[0].status = Status::Accepted;
+    p.conventions[0].selector_version = selector_version;
+    check(r, &p, &Lock::default(), Scope::Accepted, None)
+        .violations
+        .iter()
+        .map(|v| v.path.clone())
+        .collect()
+}
+
+#[test]
+fn a_member_the_config_excludes_is_in_no_role() {
+    let before = candidate(&repo(vec![], |_| {}));
+    assert_eq!((before.evidence.holders, before.evidence.total), (30, 32));
+    let r = repo(vec![tsconfig("")], |_| {});
+    let c = candidate(&r);
+    assert_eq!((c.evidence.holders, c.evidence.total), (30, 31)); // mutation:declared-apart
+    assert_eq!(outliers(&c), ["web/handlers/odd.ts"]);
+    assert!(c.evidence.lower_bound > before.evidence.lower_bound);
+    // `check` agrees for a convention written now...
+    assert_eq!(SELECTOR_VERSION, 4);
+    assert_eq!(
+        violations(&r, &c, SELECTOR_VERSION),
+        ["web/handlers/odd.ts"]
+    );
+    // ...and one written before declared scopes keeps checking the set-apart member.
+    assert_eq!(
+        violations(&r, &c, 3),
+        ["web/handlers/odd.ts", "web/handlers/seed.ts"]
+    );
+}
+
+#[test]
+fn a_config_that_was_not_read_narrows_nothing() {
+    let c = candidate(&repo(
+        vec![tsconfig(
+            "extends `@x/base`, which is not a file in the repository",
+        )],
+        |_| {},
+    ));
+    assert_eq!((c.evidence.holders, c.evidence.total), (30, 32));
+}
+
+#[test]
+fn an_entry_point_is_never_set_apart() {
+    let r = repo(vec![tsconfig("")], |files| {
+        let seed = files
+            .iter_mut()
+            .find(|f| f.path == "web/handlers/seed.ts")
+            .unwrap();
+        seed.entry_points = vec![EntryPoint {
+            symbol: "seed".into(),
+            kind: "http".into(),
+            method: Some("POST".into()),
+            route: Some("/api/seed".into()),
+            adapter: "express".into(),
+        }];
+    });
+    assert!(drift_core::declared::set_apart(&r).is_empty()); // mutation:declared-entry
+    let kinds = mine(&r, &MineOptions { max_per_repo: 200 }).kinds;
+    let units = drift_mine::roles::units(&r, &kinds);
+    let seed = units.iter().find(|u| u.name() == "seed").unwrap();
+    assert!(!seed.roles.is_empty() && seed.declared_out.is_empty());
+}
+
+#[test]
+fn a_file_reached_from_a_kept_file_is_kept() {
+    let r = repo(vec![tsconfig("")], |files| {
+        let odd = files
+            .iter_mut()
+            .find(|f| f.path == "web/handlers/odd.ts")
+            .unwrap();
+        odd.imports.push(Import {
+            module: "web/handlers/seed.ts".into(),
+            names: vec!["seed".into()],
+            type_only: false,
+            load: Default::default(),
+        });
+    });
+    let c = candidate(&r);
+    assert_eq!((c.evidence.holders, c.evidence.total), (30, 32)); // mutation:declared-reach
+}
