diff --git a/crates/drift-py/src/declared.rs b/crates/drift-py/src/declared.rs
new file mode 100644
index 00000000..1cf395e3
--- /dev/null
+++ b/crates/drift-py/src/declared.rs
@@ -0,0 +1,625 @@
+//! Declared scopes of Python package discovery ([`drift_core::declared`]): which
+//! files a project's build configuration packages.
+//!
+//! Read as data from `pyproject.toml` and `setup.cfg`, for the build backend the
+//! project names: setuptools (`[tool.setuptools]` `packages`, `packages.find`,
+//! `py-modules`, `package-dir`; `setup.cfg` `[options]`), Poetry (`packages`) and
+//! Hatch (wheel `packages`). A project that declares nothing gets no scope (nothing is
+//! inferred from an automatic discovery). Fail closed: a `setup.py` beside a
+//! declaration (it may pass its own `packages`), a TOML or INI error, a mapping or
+//! pattern Drift does not read, or two declarations give a scope with a note, which
+//! sets nothing apart.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::Path;
+
+use drift_core::DeclaredScope;
+use drift_core::declared::{PYTHON_PACKAGES, join};
+
+use crate::project::{has_file, is_project};
+
+/// The declared scopes of every Python project holding one of `files` (repo-relative
+/// Python files, analysed or skipped).
+pub fn scopes(root: &Path, files: &BTreeSet<String>) -> Vec<DeclaredScope> {
+    let mut projects = BTreeSet::new();
+    let mut seen = BTreeSet::new();
+    for f in files {
+        let mut dir = f.rsplit_once('/').map_or("", |(d, _)| d);
+        loop {
+            if !seen.insert(dir.to_string()) {
+                break;
+            }
+            if is_project(&root.join(dir)) {
+                projects.insert(dir.to_string());
+            }
+            match dir.rsplit_once('/') {
+                Some((up, _)) => dir = up,
+                None if !dir.is_empty() => dir = "",
+                None => break,
+            }
+        }
+    }
+    projects
+        .into_iter()
+        .filter_map(|d| project_scope(root, &d, files))
+        .collect()
+}
+
+fn scope(dir: &str, path: &str) -> DeclaredScope {
+    DeclaredScope {
+        path: path.to_string(),
+        source: PYTHON_PACKAGES.into(),
+        dir: dir.to_string(),
+        exts: vec!["py".into()],
+        ..Default::default()
+    }
+}
+
+fn in_dir(dir: &str, name: &str) -> String {
+    if dir.is_empty() {
+        name.to_string()
+    } else {
+        format!("{dir}/{name}")
+    }
+}
+
+/// `packages.find`: (where, include, exclude, namespaces).
+type Find = (Vec<String>, Vec<String>, Vec<String>, bool);
+
+/// What a setuptools configuration declares, before it is matched to directories.
+#[derive(Default)]
+struct Setuptools {
+    /// `package-dir` `""`: where packages are found.
+    base: String,
+    /// Explicit `packages`.
+    packages: Option<Vec<String>>,
+    /// `packages.find`: (where, include, exclude, namespaces).
+    find: Option<Find>,
+    py_modules: Vec<String>,
+}
+
+fn toml_at<'a>(t: &'a toml::Table, path: &[&str]) -> Option<&'a toml::Value> {
+    let mut cur = t.get(path[0])?;
+    for k in &path[1..] {
+        cur = cur.as_table()?.get(*k)?;
+    }
+    Some(cur)
+}
+
+fn toml_strings(v: &toml::Value, what: &str) -> Result<Vec<String>, String> {
+    match v {
+        toml::Value::String(s) => Ok(vec![s.clone()]),
+        toml::Value::Array(a) => a
+            .iter()
+            .map(|x| x.as_str().map(str::to_string))
+            .collect::<Option<_>>()
+            .ok_or_else(|| format!("`{what}` is not a list of strings")),
+        _ => Err(format!("`{what}` is not a list of strings")),
+    }
+}
+
+fn package_dir(map: &BTreeMap<String, String>) -> Result<String, String> {
+    match map.len() {
+        0 => Ok(String::new()),
+        1 if map.contains_key("") => Ok(map[""].trim_matches('/').to_string()),
+        _ => Err("`package-dir` maps packages Drift does not follow".into()),
+    }
+}
+
+/// The project's declaration, if any: `Ok(None)` when it declares nothing.
+fn project_scope(root: &Path, dir: &str, files: &BTreeSet<String>) -> Option<DeclaredScope> {
+    let abs = root.join(dir);
+    let pyproject = in_dir(dir, "pyproject.toml");
+    let setup_cfg = in_dir(dir, "setup.cfg");
+    let mut declared: Vec<(String, Result<DeclaredScope, String>)> = Vec::new();
+    if has_file(&abs, "pyproject.toml") {
+        let text = std::fs::read_to_string(abs.join("pyproject.toml")).unwrap_or_default();
+        match text.parse::<toml::Table>() {
+            Err(_) => return Some(noted(dir, &pyproject, "is not valid TOML")),
+            Ok(t) => {
+                if let Some(r) = pyproject_declaration(dir, &t, files) {
+                    declared.push((pyproject.clone(), r));
+                }
+            }
+        }
+    }
+    if has_file(&abs, "setup.cfg") {
+        let text = std::fs::read_to_string(abs.join("setup.cfg")).unwrap_or_default();
+        match ini(&text) {
+            None => return Some(noted(dir, &setup_cfg, "is not INI Drift reads")),
+            Some(cfg) => {
+                if let Some(r) = setup_cfg_declaration(&cfg) {
+                    declared.push((
+                        setup_cfg.clone(),
+                        r.and_then(|s| setuptools_scope(dir, &s, files)),
+                    ));
+                }
+            }
+        }
+    }
+    let (path, read) = match declared.len() {
+        0 => return None,
+        1 => declared.pop()?,
+        _ => {
+            return Some(noted(
+                dir,
+                &pyproject,
+                "and setup.cfg both declare packages",
+            ));
+        }
+    };
+    if has_file(&abs, "setup.py") {
+        return Some(noted(
+            dir,
+            &path,
+            "has a setup.py beside it, which may pass its own packages",
+        ));
+    }
+    Some(match read {
+        // A declaration that takes in none of the project's Python files was misread,
+        // or packages nothing Drift analyses: either way it is not read (fail closed).
+        Ok(s)
+            if !files
+                .iter()
+                .filter(|f| dir.is_empty() || f.starts_with(&format!("{dir}/")))
+                .any(|f| s.takes_in(f)) =>
+        // mutation:py-takes-none
+        {
+            noted(dir, &path, "takes in none of the project's Python files")
+        }
+        Ok(mut s) => {
+            s.path = path;
+            s
+        }
+        Err(note) => noted(dir, &path, &note),
+    })
+}
+
+fn noted(dir: &str, path: &str, note: &str) -> DeclaredScope {
+    DeclaredScope {
+        note: format!("{} {note}", path.rsplit('/').next().unwrap_or(path)),
+        ..scope(dir, path)
+    }
+}
+
+fn pyproject_declaration(
+    dir: &str,
+    t: &toml::Table,
+    files: &BTreeSet<String>,
+) -> Option<Result<DeclaredScope, String>> {
+    let backend = toml_at(t, &["build-system", "build-backend"]).and_then(|v| v.as_str());
+    match backend {
+        Some(b) if b.starts_with("poetry") => {
+            if toml_at(t, &["tool", "poetry", "package-mode"]).and_then(|v| v.as_bool())
+                == Some(false)
+            {
+                return None;
+            }
+            let pkgs = toml_at(t, &["tool", "poetry", "packages"])?;
+            Some(poetry_scope(dir, pkgs))
+        }
+        Some("hatchling.build") => {
+            let wheel = toml_at(t, &["tool", "hatch", "build", "targets", "wheel"])?.as_table()?;
+            let pkgs = wheel.get("packages")?;
+            Some((|| {
+                if [
+                    "only-include",
+                    "include",
+                    "exclude",
+                    "sources",
+                    "force-include",
+                    "only-packages",
+                ]
+                .iter()
+                .any(|k| wheel.contains_key(*k))
+                    || toml_at(t, &["tool", "hatch", "build"])
+                        .and_then(|b| b.as_table())
+                        .is_some_and(|b| {
+                            [
+                                "only-include",
+                                "include",
+                                "exclude",
+                                "sources",
+                                "force-include",
+                            ]
+                            .iter()
+                            .any(|k| b.contains_key(*k))
+                        })
+                {
+                    return Err("hatch build selects files Drift does not follow".to_string());
+                }
+                let mut s = scope(dir, "");
+                for p in toml_strings(pkgs, "packages")? {
+                    s.include.push(tree(dir, &p)?);
+                }
+                Ok(s)
+            })())
+        }
+        None | Some("setuptools.build_meta" | "setuptools.build_meta:__legacy__") => {
+            let st = toml_at(t, &["tool", "setuptools"])?.as_table()?;
+            if !["packages", "py-modules"]
+                .iter()
+                .any(|k| st.contains_key(*k))
+            {
+                return None;
+            }
+            Some((|| {
+                let mut s = Setuptools::default();
+                if let Some(pd) = st.get("package-dir") {
+                    let map: Option<BTreeMap<String, String>> = pd.as_table().and_then(|m| {
+                        m.iter()
+                            .map(|(k, v)| Some((k.clone(), v.as_str()?.to_string())))
+                            .collect()
+                    });
+                    s.base = package_dir(&map.ok_or("`package-dir` is not a table of strings")?)?;
+                }
+                match st.get("packages") {
+                    None => {}
+                    Some(toml::Value::Table(p)) => {
+                        let f = p
+                            .get("find")
+                            .and_then(|f| f.as_table())
+                            .ok_or("`packages` is a table without `find`")?;
+                        let list = |k: &str, d: &[&str]| -> Result<Vec<String>, String> {
+                            f.get(k)
+                                .map_or(Ok(d.iter().map(|x| x.to_string()).collect()), |v| {
+                                    toml_strings(v, k)
+                                })
+                        };
+                        let namespaces = f
+                            .get("namespaces")
+                            .map_or(Some(true), |v| v.as_bool())
+                            .ok_or("`namespaces` is not a boolean")?;
+                        s.find = Some((
+                            list("where", &["."])?,
+                            list("include", &["*"])?,
+                            list("exclude", &[])?,
+                            namespaces,
+                        ));
+                    }
+                    Some(v) => s.packages = Some(toml_strings(v, "packages")?),
+                }
+                if let Some(m) = st.get("py-modules") {
+                    s.py_modules = toml_strings(m, "py-modules")?;
+                }
+                setuptools_scope(dir, &s, files)
+            })())
+        }
+        Some(_) => None,
+    }
+}
+
+/// `dir/p/**`, repo-relative.
+fn tree(dir: &str, p: &str) -> Result<String, String> {
+    if p.contains(['*', '?', '[', '{']) {
+        return Err(format!("`{p}` is a pattern Drift does not read"));
+    }
+    let j =
+        join(dir, p.trim_end_matches('/')).ok_or_else(|| format!("`{p}` leaves the repository"))?;
+    Ok(if j.is_empty() {
+        "**".into()
+    } else {
+        format!("{j}/**")
+    })
+}
+
+fn poetry_scope(dir: &str, pkgs: &toml::Value) -> Result<DeclaredScope, String> {
+    let mut s = scope(dir, "");
+    let pkgs = pkgs.as_array().ok_or("`packages` is not a list")?;
+    for p in pkgs {
+        let include = p
+            .get("include")
+            .and_then(|v| v.as_str())
+            .ok_or("a package has no `include`")?;
+        let from = p.get("from").and_then(|v| v.as_str()).unwrap_or("");
+        let base = join(dir, from).ok_or("`from` leaves the repository")?;
+        if include.ends_with(".py") && !include.contains(['*', '?', '[', '{']) {
+            s.files
+                .push(join(&base, include).ok_or("`include` leaves the repository")?);
+        } else {
+            s.include.push(tree(&base, include)?);
+        }
+    }
+    Ok(s)
+}
+
+/// `fnmatch` on a dotted name: `*` matches any run, dots included.
+fn fnmatch(p: &str, name: &str) -> bool {
+    let (p, s) = (p.as_bytes(), name.as_bytes());
+    let (mut pi, mut si, mut star) = (0, 0, None);
+    while si < s.len() {
+        if pi < p.len() && (p[pi] == b'?' || p[pi] == s[si]) {
+            pi += 1;
+            si += 1;
+        } else if pi < p.len() && p[pi] == b'*' {
+            star = Some((pi, si));
+            pi += 1;
+        } else if let Some((sp, ss)) = star {
+            pi = sp + 1;
+            si = ss + 1;
+            star = Some((sp, ss + 1));
+        } else {
+            return false;
+        }
+    }
+    p[pi..].iter().all(|&c| c == b'*')
+}
+
+fn setuptools_scope(
+    dir: &str,
+    st: &Setuptools,
+    files: &BTreeSet<String>,
+) -> Result<DeclaredScope, String> {
+    let mut s = scope(dir, "");
+    let base = join(dir, &st.base).ok_or("`package-dir` leaves the repository")?;
+    // A package's own modules only: subpackages are packages of their own.
+    let package_glob = |pd: &str| {
+        if pd.is_empty() {
+            "*".to_string()
+        } else {
+            format!("{pd}/*")
+        }
+    };
+    if let Some(pkgs) = &st.packages {
+        for p in pkgs {
+            let pd = join(&base, &p.replace('.', "/")).ok_or("a package leaves the repository")?;
+            s.include.push(package_glob(&pd));
+        }
+    }
+    if let Some((wheres, include, exclude, namespaces)) = &st.find {
+        if include
+            .iter()
+            .chain(exclude)
+            .any(|p| p.contains(['[', '\\']))
+        {
+            return Err("a `find` pattern Drift does not read".into());
+        }
+        for w in wheres {
+            // `where` is relative to the project, not to `package-dir`.
+            let wd = join(dir, w).ok_or("`where` leaves the repository")?;
+            let below =
+                |d: &str| wd.is_empty() || d.strip_prefix(&wd).is_some_and(|r| r.starts_with('/'));
+            // Every directory below `where` that holds Python files, and its parents.
+            let mut dirs = BTreeSet::new();
+            for f in files {
+                let mut d = f.rsplit_once('/').map_or("", |(d, _)| d);
+                while below(d) && d != wd {
+                    dirs.insert(d.to_string());
+                    d = d.rsplit_once('/').map_or("", |(d, _)| d);
+                }
+            }
+            for d in &dirs {
+                let rel = if wd.is_empty() {
+                    d.as_str()
+                } else {
+                    &d[wd.len() + 1..]
+                };
+                // A regular package, and every parent up to `where`, has `__init__.py`.
+                let regular = || {
+                    let mut cur = d.as_str();
+                    loop {
+                        if !files.contains(&format!("{cur}/__init__.py")) {
+                            return false;
+                        }
+                        match cur.rsplit_once('/') {
+                            Some((up, _)) if up != wd && below(up) => cur = up,
+                            _ => return true,
+                        }
+                    }
+                };
+                let name = rel.replace('/', ".");
+                if (*namespaces || regular())
+                    && include.iter().any(|p| fnmatch(p, &name))
+                    && !exclude.iter().any(|p| fnmatch(p, &name))
+                {
+                    s.include.push(package_glob(d));
+                }
+            }
+        }
+    }
+    for m in &st.py_modules {
+        s.files.push(
+            join(&base, &format!("{}.py", m.replace('.', "/")))
+                .ok_or("a module leaves the repository")?,
+        );
+    }
+    Ok(s)
+}
+
+/// `[section] key = value` with indented continuation lines; `None` on a line it
+/// cannot place.
+fn ini(text: &str) -> Option<BTreeMap<String, BTreeMap<String, String>>> {
+    let mut out: BTreeMap<String, BTreeMap<String, String>> = BTreeMap::new();
+    let mut section: Option<String> = None;
+    let mut key: Option<String> = None;
+    for line in text.lines() {
+        let t = line.trim();
+        if t.is_empty() || t.starts_with('#') || t.starts_with(';') {
+            continue;
+        }
+        if line.starts_with([' ', '\t']) {
+            let (s, k) = (section.as_ref()?, key.as_ref()?);
+            let v = out.get_mut(s)?.get_mut(k)?;
+            v.push('\n');
+            v.push_str(t);
+            continue;
+        }
+        if let Some(name) = t.strip_prefix('[').and_then(|r| r.strip_suffix(']')) {
+            section = Some(name.trim().to_string());
+            out.entry(name.trim().to_string()).or_default();
+            key = None;
+            continue;
+        }
+        let (k, v) = t.split_once(['=', ':'])?;
+        let s = section.as_ref()?;
+        let k = k.trim().to_string();
+        out.get_mut(s)?.insert(k.clone(), v.trim().to_string());
+        key = Some(k);
+    }
+    Some(out)
+}
+
+fn ini_list(v: &str) -> Vec<String> {
+    v.split(['\n', ','])
+        .map(str::trim)
+        .filter(|s| !s.is_empty())
+        .map(str::to_string)
+        .collect()
+}
+
+fn setup_cfg_declaration(
+    cfg: &BTreeMap<String, BTreeMap<String, String>>,
+) -> Option<Result<Setuptools, String>> {
+    let opts = cfg.get("options")?;
+    if !opts.contains_key("packages") && !opts.contains_key("py_modules") {
+        return None;
+    }
+    Some((|| {
+        let mut s = Setuptools::default();
+        if let Some(pd) = opts.get("package_dir") {
+            let mut map = BTreeMap::new();
+            for e in ini_list(pd) {
+                let (k, v) = e.split_once('=').ok_or("`package_dir` is not a mapping")?;
+                map.insert(k.trim().to_string(), v.trim().to_string());
+            }
+            s.base = package_dir(&map)?;
+        }
+        match opts.get("packages").map(|p| p.trim()) {
+            None => {}
+            Some(f @ ("find:" | "find_namespace:")) => {
+                let find = cfg.get("options.packages.find");
+                let list = |k: &str, d: &[&str]| {
+                    find.and_then(|m| m.get(k))
+                        .map_or(d.iter().map(|x| x.to_string()).collect(), |v| ini_list(v))
+                };
+                s.find = Some((
+                    list("where", &["."]),
+                    list("include", &["*"]),
+                    list("exclude", &[]),
+                    f == "find_namespace:",
+                ));
+            }
+            Some(p) if p.starts_with("find") || p.starts_with("attr:") => {
+                return Err("`packages` is computed".to_string());
+            }
+            Some(p) => s.packages = Some(ini_list(p)),
+        }
+        if let Some(m) = opts.get("py_modules") {
+            s.py_modules = ini_list(m);
+        }
+        Ok(s)
+    })())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use drift_core::declared::pattern_out;
+
+    fn write(root: &Path, rel: &str, body: &str) {
+        let p = root.join(rel);
+        std::fs::create_dir_all(p.parent().unwrap()).unwrap();
+        std::fs::write(p, body).unwrap();
+    }
+
+    #[test]
+    fn setuptools_find_poetry_hatch_and_fail_closed() {
+        let t = tempfile::tempdir().unwrap();
+        let r = t.path();
+        let mut files = BTreeSet::new();
+        let mut add = |p: &str| {
+            write(r, p, "");
+            files.insert(p.to_string());
+        };
+        for p in [
+            "st/app/__init__.py",
+            "st/app/views.py",
+            "st/app/tests/__init__.py",
+            "st/app/tests/t.py",
+            "st/manage.py",
+            "st/scripts/seed.py",
+            "po/src/lib/a.py",
+            "po/tools/b.py",
+            "ha/src/pkg/a.py",
+            "ha/bench/b.py",
+            "cfg/pkg/__init__.py",
+            "cfg/pkg/a.py",
+            "cfg/other/x.py",
+            "dyn/pkg/a.py",
+            "dyn/tools/x.py",
+            "none/x.py",
+        ] {
+            add(p);
+        }
+        write(
+            r,
+            "st/pyproject.toml",
+            "[tool.setuptools.packages.find]\nexclude = [\"app.tests*\"]\n",
+        );
+        write(
+            r,
+            "po/pyproject.toml",
+            "[build-system]\nbuild-backend = \"poetry.core.masonry.api\"\n[tool.poetry]\npackages = [{ include = \"lib\", from = \"src\" }]\n",
+        );
+        write(
+            r,
+            "ha/pyproject.toml",
+            "[build-system]\nbuild-backend = \"hatchling.build\"\n[tool.hatch.build.targets.wheel]\npackages = [\"src/pkg\"]\n",
+        );
+        write(
+            r,
+            "cfg/setup.cfg",
+            "[metadata]\nname = x\n[options]\npackages = find:\n",
+        );
+        write(
+            r,
+            "dyn/pyproject.toml",
+            "[tool.setuptools]\npackages = [\"pkg\"]\n",
+        );
+        write(r, "dyn/setup.py", "from setuptools import setup\nsetup()\n");
+        write(r, "none/pyproject.toml", "[project]\nname = \"x\"\n");
+        // `where` is relative to the project, `package-dir` or not.
+        for p in [
+            "srcd/src/app/__init__.py",
+            "srcd/src/app/a.py",
+            "srcd/tools/t.py",
+        ] {
+            write(r, p, "");
+            files.insert(p.to_string());
+        }
+        write(
+            r,
+            "srcd/setup.cfg",
+            "[options]\npackage_dir =\n    =src\npackages = find:\n[options.packages.find]\nwhere = src\n",
+        );
+        // A declaration that takes in nothing is not read.
+        write(r, "empty/x.py", "");
+        files.insert("empty/x.py".to_string());
+        write(
+            r,
+            "empty/pyproject.toml",
+            "[tool.setuptools]\npackages = [\"missing\"]\n",
+        );
+        let s = scopes(&r.canonicalize().unwrap(), &files);
+        let out = |p: &str| pattern_out(&s, p, p.split('/').next().unwrap()).is_some();
+        assert!(!out("st/app/views.py"));
+        assert!(out("st/app/tests/t.py"), "excluded by find");
+        assert!(out("st/manage.py"));
+        assert!(
+            !out("st/scripts/seed.py"),
+            "`find` takes namespace packages in by default"
+        );
+        assert!(!out("po/src/lib/a.py"));
+        assert!(out("po/tools/b.py"));
+        assert!(!out("ha/src/pkg/a.py"));
+        assert!(out("ha/bench/b.py"));
+        assert!(!out("cfg/pkg/a.py"));
+        assert!(out("cfg/other/x.py"), "not a regular package under `find:`");
+        assert!(!out("dyn/tools/x.py"), "setup.py may pass its own packages");
+        assert!(s.iter().any(|s| s.dir == "dyn" && !s.note.is_empty()));
+        assert!(!out("none/x.py"), "a project that declares nothing");
+        assert!(!out("srcd/src/app/a.py"));
+        assert!(out("srcd/tools/t.py"));
+        assert!(!out("empty/x.py"), "a declaration that takes in nothing");
+    }
+}
