+                file("tools/used.ts", "", &["tools/deep.ts"]),
+                file("tools/deep.ts", "", &[]),
+                file("tools/alone.ts", "", &["src/app.ts"]),
+                file("tools/route.ts", "", &[]),
+                file("tools/exposed.ts", "", &[]),
+                file("tools/found.ts", "", &[]),
+            ],
+            packages: vec![PackageFacts {
+                entries: vec!["tools/exposed.ts".into()],
+                ..Default::default()
