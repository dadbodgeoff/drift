@@ -0,0 +1,458 @@
+//! Declared scope: a file the repository's own configuration leaves out of its
+//! application graph is a member of no role.
+//!
+//! Language parsers read the configuration into [`DeclaredScope`]s
+//! ([`RepoFacts::declared`]): tsconfig projects (`files`, `include`, `exclude`, through
+//! `extends` and project references), ESLint global ignores (legacy `ignorePatterns`,
+//! flat-config `ignores`-only blocks and `globalIgnores()`; never rule overrides), the
+//! `files` of a published package, and Python package discovery (`pyproject.toml`,
+//! `setup.cfg`). This module decides which analysed files they set apart
+//! ([`set_apart`]). Deterministic and authored by the repo: no names, no thresholds.
+//!
+//! - **Governance.** For each source, the scopes that govern a file are those of the
+//!   deepest directory among the scopes that can govern it: any ancestor directory for
+//!   ESLint (the nearest config lints a file), a directory at or below the file's
+//!   package for a tsconfig, the file's own package for `npm-files` and
+//!   `python-packages`. A file is out by a source only when every scope governing it
+//!   was read, judges its extension and takes it in nowhere. Every `tsconfig*.json` of
+//!   a directory, and every project they reference, governs together: one that takes
+//!   the file in keeps it.
+//! - **Fail closed.** A config that could not be read is a scope with a
+//!   [`DeclaredScope::note`]: it still governs its directory and sets nothing apart, so
+//!   a config Drift cannot read never narrows a role, and never widens one.
+//! - **Reachable files are kept.** A file an adapter found an entry point in, a source
+//!   a package manifest exposes ([`crate::PackageFacts::entries`]), and every file a
+//!   kept file imports, registers or discovers (to any depth) stays a member, whatever
+//!   a config says: it is in the application graph.
+
+use std::collections::{BTreeMap, BTreeSet, VecDeque};
+
+use crate::facts::{DeclaredScope, FileFacts, RepoFacts};
+
+/// tsconfig projects.
+pub const TSCONFIG: &str = "tsconfig";
+/// ESLint global ignores.
+pub const ESLINT: &str = "eslint";
+/// A published package's `package.json` `files`.
+pub const NPM_FILES: &str = "npm-files";
+/// Python package discovery.
+pub const PYTHON_PACKAGES: &str = "python-packages";
+/// Every source, in the order [`pattern_out`] asks them.
+pub const SOURCES: &[&str] = &[TSCONFIG, ESLINT, NPM_FILES, PYTHON_PACKAGES];
+
+/// Most alternatives a pattern's `{a,b}` groups expand to.
+const MAX_ALTERNATIVES: usize = 64;
+/// Most `**` segments in a pattern (matching backtracks once per `**`).
+const MAX_GLOBSTARS: usize = 4;
+
+/// The pattern's `{a,b}` groups expanded. `None` when a group is unbalanced or the
+/// pattern expands to more than [`MAX_ALTERNATIVES`].
+pub fn expand_braces(glob: &str) -> Option<Vec<String>> {
+    let Some(open) = glob.find('{') else {
+        return (!glob.contains('}')).then(|| vec![glob.to_string()]);
+    };
+    let mut depth = 0usize;
+    let mut close = None;
+    let mut commas = Vec::new();
+    for (i, c) in glob[open..].char_indices() {
+        match c {
+            '{' => depth += 1,
+            '}' => {
+                depth -= 1;
+                if depth == 0 {
+                    close = Some(open + i);
+                    break;
+                }
+            }
+            ',' if depth == 1 => commas.push(open + i),
+            _ => {}
+        }
+    }
+    let close = close?;
+    let (head, tail) = (&glob[..open], &glob[close + 1..]);
+    let mut bounds = vec![open];
+    bounds.extend(commas);
+    bounds.push(close);
+    let mut out = Vec::new();
+    for w in bounds.windows(2) {
+        let alt = &glob[w[0] + 1..w[1]];
+        for rest in expand_braces(&format!("{head}{alt}{tail}"))? {
+            out.push(rest);
+            if out.len() > MAX_ALTERNATIVES {
+                return None;
+            }
+        }
+    }
+    Some(out)
+}
+
+/// True when [`glob_match`] reads `glob` exactly: `*`, `?`, `**` and `{a,b}` only. A
+/// negation, a character class, an escape, an extglob, a template variable or a `..`
+/// segment is not read, and the config holding it is read as unreadable.
+pub fn supported_glob(glob: &str) -> bool {
+    !glob.is_empty()
+        && !glob.starts_with('!')
+        && !glob.contains(['[', ']', '\\', '$'])
+        && !["+(", "@(", "!(", "?(", "*("]
+            .iter()
+            .any(|x| glob.contains(x))
+        && !glob.split('/').any(|s| s == "..")
+        && glob.split('/').filter(|s| *s == "**").count() <= MAX_GLOBSTARS
+        && expand_braces(glob).is_some()
+}
+
+/// `rel` (a config's path, POSIX) joined to the repo-relative directory `dir` and
+/// normalised (`./` and `.` dropped, `..` applied). `None` when it leaves the repo.
+pub fn join(dir: &str, rel: &str) -> Option<String> {
+    let mut out: Vec<&str> = dir.split('/').filter(|s| !s.is_empty()).collect();
+    for seg in rel.split('/') {
+        match seg {
+            "" | "." => {}
+            ".." => {
+                out.pop()?;
+            }
+            s => out.push(s),
+        }
+    }
+    Some(out.join("/"))
+}
+
+/// True when the repo-relative `path` matches the repo-relative `glob`: `*` and `?`
+/// within one path segment, `**` as a segment for any number of segments, `{a,b}`
+/// alternatives.
+pub fn glob_match(glob: &str, path: &str) -> bool {
+    let path: Vec<&str> = path.split('/').filter(|s| !s.is_empty()).collect();
+    expand_braces(glob).is_some_and(|alts| {
+        alts.iter().any(|g| {
+            let g: Vec<&str> = g
+                .split('/')
+                .filter(|s| !s.is_empty() && *s != ".")
+                .collect();
+            segments_match(&g, &path)
+        })
+    })
+}
+
+fn segments_match(glob: &[&str], path: &[&str]) -> bool {
+    match glob.first() {
+        None => path.is_empty(),
+        Some(&"**") => (0..=path.len()).any(|i| segments_match(&glob[1..], &path[i..])),
+        Some(g) => {
+            !path.is_empty()
+                && segment_match(g.as_bytes(), path[0].as_bytes())
+                && segments_match(&glob[1..], &path[1..])
+        }
+    }
+}
+
+/// `*` and `?` within one segment.
+fn segment_match(p: &[u8], s: &[u8]) -> bool {
+    let (mut pi, mut si) = (0, 0);
+    let mut star: Option<(usize, usize)> = None;
+    while si < s.len() {
+        if pi < p.len() && (p[pi] == b'?' || p[pi] == s[si]) {
+            pi += 1;
+            si += 1;
+        } else if pi < p.len() && p[pi] == b'*' {
+            star = Some((pi, si));
+            pi += 1;
+        } else if let Some((sp, ss)) = star {
+            pi = sp + 1;
+            si = ss + 1;
+            star = Some((sp, ss + 1));
+        } else {
+            return false;
+        }
+    }
+    p[pi..].iter().all(|&c| c == b'*')
+}
+
+/// `path` is `dir` itself or below it.
+fn at_or_below(path: &str, dir: &str) -> bool {
+    dir.is_empty() || path == dir || path.strip_prefix(dir).is_some_and(|r| r.starts_with('/'))
+}
+
+fn extension(path: &str) -> &str {
+    let file = path.rsplit('/').next().unwrap_or(path);
+    file.rsplit_once('.').map_or("", |(_, e)| e)
+}
+
+impl DeclaredScope {
+    /// The scope says something about files of `path`'s extension.
+    pub fn judges(&self, path: &str) -> bool {
+        self.exts.is_empty() || self.exts.iter().any(|e| e == extension(path))
+    }
+
+    /// The scope takes `path` in: a listed file, or a match of an `include` pattern
+    /// and of no `exclude` pattern (an excluded directory excludes all below it).
+    pub fn takes_in(&self, path: &str) -> bool {
+        self.files.iter().any(|f| f == path)
+            || (self.include.iter().any(|g| glob_match(g, path))
+                && !self
+                    .exclude
+                    .iter()
+                    .any(|g| glob_match(g, path) || glob_match(&format!("{g}/**"), path)))
+    }
+
+    /// The scope can govern `path`, a file of workspace package `package`.
+    pub fn can_govern(&self, path: &str, package: &str) -> bool {
+        at_or_below(path, &self.dir)
+            && path != self.dir
+            && match self.source.as_str() {
+                TSCONFIG => at_or_below(&self.dir, package),
+                NPM_FILES | PYTHON_PACKAGES => self.dir == package,
+                _ => true,
+            }
+    }
+}
+
+/// The scope that sets `path` (in workspace package `package`) apart by its patterns
+/// alone, before reachability ([`set_apart`]): for the first source under which every
+/// governing scope was read, judges the file and takes it in nowhere.
+pub fn pattern_out<'s>(
+    scopes: &'s [DeclaredScope],
+    path: &str,
+    package: &str,
+) -> Option<&'s DeclaredScope> {
+    SOURCES.iter().find_map(|source| {
+        let candidates: Vec<&DeclaredScope> = scopes
+            .iter()
+            .filter(|s| s.source == *source && s.can_govern(path, package))
+            .collect();
+        // Every candidate's directory is an ancestor of `path`: the longest is deepest.
+        let deepest = candidates.iter().map(|s| s.dir.len()).max()?;
+        let governing: Vec<&DeclaredScope> = candidates
+            .into_iter()
+            .filter(|s| s.dir.len() == deepest)
+            .collect();
+        governing
+            .iter()
+            .all(|s| s.note.is_empty() && s.judges(path) && !s.takes_in(path)) // mutation:declared-note
+            .then(|| governing[0])
+    })
+}
+
+/// The analysed files the repository's configuration sets apart, each with the config
+/// that does ([`DeclaredScope::path`]): [`pattern_out`], less every reachable file
+/// (see the module documentation). Empty when the facts hold no scope (a single-file
+/// scan, whose file is sent to a full scan when its patterns set it apart).
+pub fn set_apart(repo: &RepoFacts) -> BTreeMap<String, String> {
+    if repo.declared.is_empty() {
+        return BTreeMap::new();
+    }
+    let mut out: BTreeMap<&str, &str> = repo
+        .files
+        .iter()
+        .filter_map(|f| {
+            pattern_out(&repo.declared, &f.path, &f.package)
+                .map(|s| (f.path.as_str(), s.path.as_str()))
+        })
+        .collect();
+    if out.is_empty() {
+        return BTreeMap::new();
+    }
+    // Entry points an adapter found, and what a package manifest exposes, are reached
+    // from outside the code: kept [STRICT].
+    let exposed: BTreeSet<&str> = repo
+        .packages
+        .iter()
+        .flat_map(|p| p.entries.iter().map(String::as_str))
+        .collect();
+    for f in &repo.files {
+        if !f.entry_points.is_empty() || exposed.contains(f.path.as_str()) {
+            out.remove(f.path.as_str()); // mutation:declared-entry
+        }
+    }
+    // Whatever a kept file imports, registers or discovers is in the graph too.
+    let by_path: BTreeMap<&str, &FileFacts> =
+        repo.files.iter().map(|f| (f.path.as_str(), f)).collect();
+    let mut queue: VecDeque<&FileFacts> = repo
+        .files
+        .iter()
+        .filter(|f| !out.contains_key(f.path.as_str()))
+        .collect();
+    while let Some(f) = queue.pop_front() {
+        if out.is_empty() {
+            break;
+        }
+        let mut reached: Vec<&str> = f.imports.iter().map(|i| i.module.as_str()).collect();
+        for r in &f.registries {
+            reached.extend(
+                r.items
+                    .iter()
+                    .map(|i| i.target.split('#').next().unwrap_or_default()),
+            );
+        }
+        for g in f.discovers.iter().filter(|g| !g.contains(':')) {
+            reached.extend(out.keys().copied().filter(|p| glob_match(g, p)));
+        }
+        for p in reached {
+            if out.remove(p).is_some() // mutation:declared-reach
+                && let Some(next) = by_path.get(p)
+            {
+                queue.push_back(next);
+            }
+        }
+    }
+    out.into_iter()
+        .map(|(p, c)| (p.to_string(), c.to_string()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::facts::{EntryPoint, Import, PackageFacts};
+
+    fn scope(source: &str, dir: &str, include: &[&str], exclude: &[&str]) -> DeclaredScope {
+        DeclaredScope {
+            path: format!("{dir}/cfg"),
+            source: source.into(),
+            dir: dir.into(),
+            include: include.iter().map(|s| s.to_string()).collect(),
+            exclude: exclude.iter().map(|s| s.to_string()).collect(),
+            ..Default::default()
+        }
+    }
+
+    fn file(path: &str, package: &str, imports: &[&str]) -> FileFacts {
+        FileFacts {
+            path: path.into(),
+            package: package.into(),
+            imports: imports
+                .iter()
+                .map(|m| Import {
+                    module: m.to_string(),
+                    names: vec![],
+                    type_only: false,
+                    load: Default::default(),
+                })
+                .collect(),
+            ..Default::default()
+        }
+    }
+
+    #[test]
+    fn globs() {
+        assert!(glob_match("src/**", "src/a/b.ts"));
+        assert!(glob_match("src/**/*.ts", "src/b.ts"));
+        assert!(!glob_match("src/*", "src/a/b.ts"));
+        assert!(glob_match("src/*", "src/b.ts"));
+        assert!(glob_match(
+            "**/*.config.{js,cjs}",
+            "apps/x/electron.config.cjs"
+        ));
+        assert!(!glob_match(
+            "**/*.config.{js,cjs}",
+            "apps/x/electron.config.ts"
+        ));
+        assert!(glob_match("a/?.ts", "a/b.ts"));
+        assert!(glob_match("**", "x"));
+        assert!(!glob_match("scripts", "scripts/a.ts"));
+        assert_eq!(
+            expand_braces("a{b,c{d,e}}f").unwrap(),
+            ["abf", "acdf", "acef"]
+        );
+        assert!(expand_braces("a{b").is_none());
+        assert!(!supported_glob("!dist"));
+        assert!(!supported_glob("src/[ab].ts"));
+        assert!(!supported_glob("../x/**"));
+        assert!(!supported_glob("${configDir}/src"));
+        assert!(supported_glob("app/(group)/**"));
+        assert_eq!(
+            join("apps/web", "./src/../lib").as_deref(),
+            Some("apps/web/lib")
+        );
+        assert_eq!(join("", "../x"), None);
+    }
+
+    #[test]
+    fn excluded_directories_exclude_all_below() {
+        let s = scope(TSCONFIG, "", &["**"], &["scripts"]);
+        assert!(!s.takes_in("scripts/a/b.ts"));
+        assert!(s.takes_in("src/a.ts"));
+        let mut f = scope(TSCONFIG, "", &["src/**"], &["src/gen"]);
+        f.files = vec!["src/gen/keep.ts".into()];
+        assert!(
+            f.takes_in("src/gen/keep.ts"),
+            "a listed file is in whatever exclude says"
+        );
+        assert!(!f.takes_in("src/gen/other.ts"));
+    }
+
+    #[test]
+    fn the_deepest_governing_configs_decide_together() {
+        let scopes = vec![
+            scope(ESLINT, "", &["**"], &["apps/web/**"]),
+            scope(ESLINT, "apps/web", &["apps/web/**"], &[]),
+            scope(TSCONFIG, "apps/api", &["apps/api/src/**"], &[]),
+            scope(TSCONFIG, "apps/api", &["apps/api/*.config.ts"], &[]),
+        ];
+        // The nearest ESLint config lints apps/web, and ignores nothing there.
+        assert!(pattern_out(&scopes, "apps/web/a.ts", "apps/web").is_none());
+        // One tsconfig of the directory takes the config file in: it is kept.
+        assert!(pattern_out(&scopes, "apps/api/vite.config.ts", "apps/api").is_none());
+        let out = pattern_out(&scopes, "apps/api/scripts/seed.ts", "apps/api").unwrap();
+        assert_eq!(out.source, TSCONFIG);
+        // A tsconfig above the file's package does not govern it.
+        let root = vec![scope(TSCONFIG, "", &["src/**"], &[])];
+        assert!(pattern_out(&root, "packages/x/a.ts", "packages/x").is_none());
+        assert!(pattern_out(&root, "lib/a.ts", "").is_some());
+        // A package's `files` governs that package only.
+        let npm = vec![scope(NPM_FILES, "", &["lib", "lib/**"], &[])];
+        assert!(pattern_out(&npm, "packages/x/a.ts", "packages/x").is_none());
+        assert!(pattern_out(&npm, "scripts/a.ts", "").is_some());
+        assert!(pattern_out(&npm, "lib/a.ts", "").is_none());
+    }
+
+    #[test]
+    fn a_config_that_was_not_read_sets_nothing_apart() {
+        let mut noted = scope(TSCONFIG, "", &[], &[]);
+        noted.note = "extends a config that could not be read".into();
+        let scopes = vec![scope(TSCONFIG, "", &["src/**"], &[]), noted];
+        assert!(pattern_out(&scopes, "scripts/a.ts", "").is_none());
+        // A file of an extension the scope does not judge is never out by it.
+        let mut ts = scope(TSCONFIG, "", &["src/**"], &[]);
+        ts.exts = vec!["ts".into()];
+        assert!(pattern_out(&[ts.clone()], "scripts/a.js", "").is_none());
+        assert!(pattern_out(&[ts], "scripts/a.ts", "").is_some());
+    }
+
+    #[test]
+    fn reachable_files_are_kept() {
+        let mut repo = RepoFacts {
+            declared: vec![scope(TSCONFIG, "", &["src/**"], &[])],
