diff --git a/crates/drift-cli/tests/py_framework_lineage.rs b/crates/drift-cli/tests/py_framework_lineage.rs
new file mode 100644
index 00000000..abc0be3b
--- /dev/null
+++ b/crates/drift-cli/tests/py_framework_lineage.rs
@@ -0,0 +1,121 @@
+//! python11 M1 (round 11 research, candidate for F12): pydantic models are a lineage
+//! kind of their own (`schema`), as DRF serializers and Django models are. The kind is
+//! mined on its own: a naming rule over it is proposed (naming rules over plain Python
+//! classes are not, W3), the value types beside it are no outliers, and the framework
+//! base that forms the role is not restated as a rule. Synthetic project.
+
+use std::path::Path;
+use std::process::Command;
+
+use serde_json::Value;
+
+/// The CLI under test: `DRIFT_TEST_BIN` when set (a private copy, so another build sharing
+/// this target directory cannot swap the binary mid-run), else Cargo's own.
+static BIN: std::sync::LazyLock<String> = std::sync::LazyLock::new(|| {
+    std::env::var("DRIFT_TEST_BIN").unwrap_or_else(|_| env!("CARGO_BIN_EXE_drift").to_string())
+});
+
+fn write(root: &Path, rel: &str, body: &str) {
+    let p = root.join(rel);
+    std::fs::create_dir_all(p.parent().unwrap()).unwrap();
+    std::fs::write(p, body).unwrap();
+}
+
+fn census(root: &Path) -> Value {
+    let out = Command::new(&*BIN)
+        .env("DRIFT_TEST_UNSHOWN", "1")
+        .args(["census", "--json", "--python-proposals", "--max", "200"])
+        .current_dir(root)
+        .env_remove("DRIFT_CACHE_DIR")
+        .env_remove("DRIFT_EXPERIMENTAL")
+        .output()
+        .unwrap();
+    assert!(
+        out.status.success(),
+        "census failed: {}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    serde_json::from_slice(&out.stdout).unwrap()
+}
+
+/// `gizmo`: 30 pydantic schemas `Part{i}Out` in `gizmo/schemas/`, three `str` value types
+/// beside them, and plain modules around.
+fn repo() -> tempfile::TempDir {
+    let dir = tempfile::tempdir().unwrap();
+    let r = dir.path();
+    write(
+        r,
+        "pyproject.toml",
+        "[project]\nname = \"gizmo\"\ndependencies = [\"pydantic\"]\n",
+    );
+    write(r, "gizmo/__init__.py", "");
+    for i in 0..30 {
+        let extra = if i < 3 {
+            format!("\n\nclass Tag{i}(str):\n    pass\n")
+        } else {
+            String::new()
+        };
+        write(
+            r,
+            &format!("gizmo/schemas/s{i:02}.py"),
+            &format!(
+                "from pydantic import BaseModel\n\n\nclass Part{i}Out(BaseModel):\n    name: str\n{extra}"
+            ),
+        );
+    }
+    for i in 0..30 {
+        write(
+            r,
+            &format!("gizmo/util/h{i:02}.py"),
+            &format!("def helper_{i}():\n    return {i}\n"),
+        );
+    }
+    dir
+}
+
+fn proposals(v: &Value) -> &Vec<Value> {
+    v["proposals"].as_array().unwrap()
+}
+
+fn naming<'a>(v: &'a Value, pattern: &str) -> Option<&'a Value> {
+    proposals(v)
+        .iter()
+        .find(|p| p["rule"]["type"] == "named" && p["rule"]["pattern"] == pattern)
+}
+
+fn extends(v: &Value, base: &str) -> bool {
+    proposals(v).iter().any(|p| {
+        p["rule_kind"] == "wrapped_by:extends"
+            && p["rule"]["any_of"]
+                .as_array()
+                .is_some_and(|a| a.iter().any(|t| t.as_str().unwrap_or("").contains(base)))
+    })
+}
+
+fn summary(v: &Value) -> Vec<String> {
+    proposals(v)
+        .iter()
+        .map(|p| p["summary"].as_str().unwrap_or("").to_string())
+        .collect()
+}
+
+#[test]
+fn pydantic_models_form_a_schema_role_of_their_own() {
+    let dir = repo();
+    let v = census(dir.path());
+    let c = naming(&v, "*Out").unwrap_or_else(|| panic!("no *Out rule: {:#?}", summary(&v)));
+    assert_eq!(c["role"]["member_kind"], "schema", "{c:#}");
+    assert_eq!(
+        c["outliers_total"], 0,
+        "the str value types are no schemas: {c:#}"
+    );
+    assert!(
+        c["summary"]
+            .as_str()
+            .unwrap()
+            .starts_with("schemas in gizmo/schemas/**"),
+        "{c:#}"
+    );
+    // The base that forms the role is not a rule of it.
+    assert!(!extends(&v, "BaseModel"), "{:#?}", summary(&v));
+}
