+#[test]
+fn a_subtree_that_depends_less_on_the_role_than_the_role_on_it_is_not_widened() {
+    // 600 kit files, 30 of them importing `views/forms`: kit imports `views/**` from more
+    // files (30) than `views/**` imports kit (24), so `views/**` is no layer above kit,
+    // although the bound (570/600) holds.
+    let mut files = Vec::new();
+    for i in 0..600 {
+        let imports: &[&str] = if i < 30 { &["views/forms/f3.tsx"] } else { &[] };
+        files.push(file(&format!("kit/k{i}.ts"), imports));
+    }
+    for i in 0..12 {
+        files.push(file(&format!("views/charts/c{i}.tsx"), &["kit/k1.ts"]));
+        files.push(file(&format!("views/forms/f{i}.tsx"), &["kit/k2.ts"]));
+    }
+    let rules = layering(&mined(&repo(files)));
+    assert!(
+        !rules
+            .iter()
+            .any(|(d, s, _)| d == "kit" && s == "import:views"),
+        "{rules:?}"
+    );
+}
