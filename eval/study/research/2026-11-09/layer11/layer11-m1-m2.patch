+/// `parts/` (200 files) sits below `screens/`: every screen file imports a part. Each
+/// of `hook_users` parts imports `screens/board/board-context.ts`, and `others` import
+/// another screen module each.
+fn facade(hook_users: usize, others: &[&str], extra: Vec<FileFacts>) -> RepoFacts {
+    let mut files = Vec::new();
+    for i in 0..200 {
+        files.push(file(&format!("parts/p{i}.tsx"), &[]));
+    }
+    for i in 0..hook_users {
+        files.push(file(
+            &format!("parts/h{i}.tsx"),
+            &["screens/board/board-context.ts"],
+        ));
+    }
+    for (i, m) in others.iter().enumerate() {
+        files.push(file(&format!("parts/o{i}.tsx"), &[m]));
+    }
+    files.push(file("screens/board/board-context.ts", &[]));
+    for i in 0..20 {
+        files.push(file(
+            &format!("screens/board/panel{i}.tsx"),
+            &[&format!("parts/p{i}.tsx")],
+        ));
+    }
+    files.extend(extra);
+    repo(files)
+}
+
+fn parts_rule(cs: &[Candidate]) -> Option<&Candidate> {
+    cs.iter().find(|c| {
+        c.role.dir == "parts"
+            && matches!(&c.rule, Rule::Avoids { signal, .. } if signal.starts_with("import:"))
+    })
+}
+
+#[test]
+fn outliers_sharing_one_target_module_make_it_the_exception() {
+    let cs = mined(&facade(6, &[], vec![]));
+    let c = parts_rule(&cs).expect("parts avoid screens");
+    let Rule::Avoids { signal, except } = &c.rule else {
+        unreachable!()
+    };
+    assert_eq!(signal, "import:screens");
+    assert_eq!(except, &["screens/board/board-context.ts".to_string()]);
+    assert_eq!((c.evidence.holders, c.evidence.total), (206, 206));
+    assert!(
+        c.rule
+            .describe()
+            .contains("except from screens/board/board-context.ts"),
+        "{}",
+        c.rule.describe()
+    );
+}
+
+#[test]
+fn check_allows_the_exception_and_flags_any_other_target_module() {
+    let p = accept_all(&mined(&facade(6, &[], vec![])));
+    let after = facade(
+        6,
+        &[],
+        vec![
+            file("parts/new1.tsx", &["screens/board/board-context.ts"]),
+            file("parts/new2.tsx", &["screens/board/panel3.tsx"]),
+        ],
+    );
+    let report = check(&after, &p, &Lock::default(), Scope::Accepted, None);
+    let flagged: Vec<&str> = report
+        .violations
+        .iter()
+        .filter(|v| !v.baselined)
+        .map(|v| v.path.as_str())
+        .collect();
+    assert_eq!(flagged, ["parts/new2.tsx"]);
+}
+
+#[test]
+fn the_exception_needs_three_outliers_and_three_quarters_of_them() {
+    // 2 hook users: too few.
+    let cs = mined(&facade(2, &[], vec![]));
+    let c = parts_rule(&cs).expect("parts avoid screens");
+    assert!(matches!(&c.rule, Rule::Avoids { except, .. } if except.is_empty()));
+    // 3 of 5 outliers (60%): under 75%.
+    let cs = mined(&facade(
+        3,
+        &["screens/board/panel1.tsx", "screens/board/panel2.tsx"],
+        vec![],
+    ));
+    let c = parts_rule(&cs).expect("parts avoid screens");
+    assert!(matches!(&c.rule, Rule::Avoids { except, .. } if except.is_empty()));
+    // 4 of 5 (80%): excepted, and the fifth outlier stays one.
+    let cs = mined(&facade(4, &["screens/board/panel1.tsx"], vec![]));
+    let c = parts_rule(&cs).expect("parts avoid screens");
+    assert!(matches!(&c.rule, Rule::Avoids { except, .. } if except.len() == 1));
+    assert_eq!(c.evidence.total - c.evidence.holders, 1);
+}
+
+#[test]
+fn a_tie_between_target_modules_excepts_neither() {
+    // Three outliers each import two screen modules: both are shared by every outlier.
+    let both = |i: usize| {
+        file(
+            &format!("parts/t{i}.tsx"),
+            &["screens/board/board-context.ts", "screens/board/panel1.tsx"],
+        )
+    };
+    let cs = mined(&facade(0, &[], (0..3).map(both).collect()));
+    let c = parts_rule(&cs).expect("parts avoid screens");
+    assert!(matches!(&c.rule, Rule::Avoids { except, .. } if except.is_empty()));
+}
+
+#[test]
+fn the_exception_rescues_no_rule() {
+    // 30 hook users of 230: the bound fails without the exception, so no rule.
+    let cs = mined(&facade(30, &[], vec![]));
+    assert!(parts_rule(&cs).is_none());
+}
+
+#[test]
+fn imports_are_found_by_relative_and_aliased_specifiers() {
+    let text =
+        "import { a } from \"react\";\nimport { useBoard } from '@/screens/board/board-context';\n";
+    assert_eq!(
+        find_import(text, "parts/h1.tsx", "screens/board/board-context.ts"),
+        Some((2, "@/screens/board/board-context".to_string()))
+    );
+    let text = "const x = require(\"../screens/board\");\n";
+    assert_eq!(
+        find_import(text, "parts/h1.tsx", "screens/board/index.ts"),
+        Some((1, "../screens/board".to_string()))
+    );
+    assert_eq!(
+        find_import(
+            "import x from './other';\n",
+            "parts/h1.tsx",
+            "screens/board/index.ts"
+        ),
+        None
+    );
+}
