+/// Outliers needed before the module they share is an exception of the rule (as
+/// [`REFINEMENT_MIN_OUTLIERS`]).
+const EXCEPTION_MIN_OUTLIERS: usize = 3;
+
+/// A layering rule whose outliers mostly import one module of the avoided area (a
+/// shared context provider, a facade) excepts that module: "`components/**` do not
+/// import from `app/board/**` except from `app/board/board-context.ts`". The module is
+/// a sanctioned way in, not one violation per importer, and a new importer of it is
+/// not flagged either (`check` applies the exception, [`Rule::holds`]).
+///
+/// The module must be imported by at least [`EXCEPTION_MIN_OUTLIERS`] outliers and by
+/// at least [`MIN_LOWER_BOUND`] of them, with no tie. [STRICT] The draft passed the
+/// bound without it (no rescue), and when the module is the only file of the area,
+/// nothing is excepted (the rule would be empty).
+fn target_exception(d: Draft, units: &[Unit], ctx: &RepoContext) -> Draft {
+    if !layer11_on("m2") {
+        return d;
+    }
+    let Rule::Avoids { signal, .. } = &d.rule else {
+        return d;
+    };
+    let signal = signal.clone();
+    let target = signal
+        .strip_prefix("import:")
+        .unwrap_or_default()
+        .to_string();
+    let mut by_module: BTreeMap<&str, usize> = BTreeMap::new();
+    let mut outliers = 0;
+    for &m in &d.members {
+        let View::File(f) = units[m].view else {
+            continue;
+        };
+        let modules: BTreeSet<&str> = layer_signals(f, ctx)
+            .filter(|(g, _)| *g == signal)
+            .map(|(_, module)| module)
+            .collect();
+        if !d.holders.contains(&m) {
+            outliers += 1;
+            for module in modules {
+                *by_module.entry(module).or_default() += 1;
+            }
+        }
+    }
+    let mut ranked: Vec<(&str, usize)> = by_module.into_iter().collect();
+    ranked.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(b.0)));
+    let Some(&(module, count)) = ranked.first() else {
+        return d;
+    };
+    let tie = ranked.get(1).is_some_and(|&(_, c)| c == count);
+    if tie || count < EXCEPTION_MIN_OUTLIERS || (count as f64) < MIN_LOWER_BOUND * outliers as f64 {
+        return d;
+    }
+    // Another file in the avoided area, or the exception is the whole rule.
+    let in_target = |p: &str| p.starts_with(&format!("{target}/"));
+    if !units
+        .iter()
+        .any(|u| matches!(u.view, View::File(f) if in_target(&f.path) && f.path != module))
+    {
+        return d;
+    }
+    let rule = Rule::Avoids {
+        signal,
+        except: vec![module.to_string()],
+    };
+    let holders: BTreeSet<usize> = d
+        .members
+        .iter()
+        .copied()
+        .filter(|&m| rule.holds_in(Some(&d.role), &units[m].view, ctx))
+        .collect();
+    let lb = wilson_lower_bound(holders.len(), d.n);
+    let score = d.score / d.lb.max(f64::EPSILON) * lb;
+    Draft {
+        rule,
+        holders,
+        lb,
+        score,
+        ..d
+    }
+}
