+//! Layering at the shallowest area that holds, and a shared target module as the
+//! rule's one exception (round 11, eval/study/research/2026-11-09/layer11.md). Every
+//! name is invented.
+
+use drift_core::{FileFacts, Import, RepoFacts};
+use drift_mine::check::{Scope, check, find_import};
+use drift_mine::mine::{Candidate, MineOptions, Rule, mine_unshown as mine};
+use drift_mine::policy::{ConventionsFile, Lock, Status};
+
+fn file(path: &str, imports: &[&str]) -> FileFacts {
+    FileFacts {
+        path: path.into(),
+        lang: "ts".into(),
+        parse_ok: true,
+        imports: imports
+            .iter()
+            .map(|m| Import {
+                module: (*m).into(),
+                names: vec!["x".into()],
+                type_only: false,
+                load: Default::default(),
+            })
+            .collect(),
+        ..Default::default()
+    }
+}
+
+fn repo(files: Vec<FileFacts>) -> RepoFacts {
+    let mut r = RepoFacts {
+        files,
+        ..Default::default()
+    };
+    r.normalize();
+    r
+}
+
+fn mined(r: &RepoFacts) -> Vec<Candidate> {
+    mine(r, &MineOptions { max_per_repo: 200 }).candidates
+}
+
+/// `(role dir, signal, except)` of every layering candidate.
+fn layering(cs: &[Candidate]) -> Vec<(String, String, Vec<String>)> {
+    cs.iter()
+        .filter_map(|c| match &c.rule {
+            Rule::Avoids { signal, except } if signal.starts_with("import:") => {
+                Some((c.role.dir.clone(), signal.clone(), except.clone()))
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+fn accept_all(cs: &[Candidate]) -> ConventionsFile {
+    let mut p = ConventionsFile::merge(None, "test", Default::default(), cs);
+    for c in &mut p.conventions {
+        c.status = Status::Accepted;
+    }
+    p
+}
+
+/// `kit/` (60 files) sits below `views/`: `views/charts` and `views/forms` import kit
+/// from every file, and one kit file imports `views/forms`.
+fn layered(extra: Vec<FileFacts>) -> RepoFacts {
+    let mut files = Vec::new();
+    for i in 0..60 {
+        let imports: &[&str] = if i == 0 { &["views/forms/f3.tsx"] } else { &[] };
+        files.push(file(&format!("kit/k{i}.ts"), imports));
+    }
+    for i in 0..12 {
+        files.push(file(&format!("views/charts/c{i}.tsx"), &["kit/k1.ts"]));
+        files.push(file(&format!("views/forms/f{i}.tsx"), &["kit/k2.ts"]));
+    }
+    files.extend(extra);
+    repo(files)
+}
+
+#[test]
+fn a_layering_rule_is_stated_at_the_shallowest_area_that_holds() {
+    let cs = mined(&layered(vec![]));
+    let rules = layering(&cs);
+    let kit: Vec<&str> = rules
+        .iter()
+        .filter(|(dir, _, _)| dir == "kit")
+        .map(|(_, s, _)| s.as_str())
+        .collect();
+    assert_eq!(kit, ["import:views"], "{rules:?}");
+}
+
+#[test]
+fn the_wide_rule_flags_a_sibling_no_narrow_card_named() {
+    let p = accept_all(&mined(&layered(vec![])));
+    let after = layered(vec![file("kit/k60.ts", &["views/charts/c2.tsx"])]);
+    let report = check(&after, &p, &Lock::default(), Scope::Accepted, None);
+    let flagged: Vec<(&str, Option<&str>)> = report
+        .violations
+        .iter()
+        .filter(|v| !v.baselined)
+        .map(|v| {
+            (
+                v.path.as_str(),
+                v.import.as_ref().map(|h| h.module.as_str()),
+            )
+        })
+        .collect();
+    assert_eq!(
+        flagged,
+        [
+            ("kit/k0.ts", Some("views/forms/f3.tsx")),
+            ("kit/k60.ts", Some("views/charts/c2.tsx"))
+        ]
+    );
+}
