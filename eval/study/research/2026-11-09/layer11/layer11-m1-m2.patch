+#[test]
+fn every_narrow_rule_under_a_wide_one_is_dropped() {
+    // Two kit files import two folders of views: the narrow rules (119/120 each) and the
+    // wide one (118/120) all hold; only the wide one is proposed.
+    let mut files = Vec::new();
+    for i in 0..120 {
+        let imports: &[&str] = match i {
+            0 => &["views/forms/f3.tsx"],
+            1 => &["views/charts/c3.tsx"],
+            _ => &[],
+        };
+        files.push(file(&format!("kit/k{i}.ts"), imports));
+    }
+    for i in 0..12 {
+        files.push(file(&format!("views/charts/c{i}.tsx"), &["kit/k5.ts"]));
+        files.push(file(&format!("views/forms/f{i}.tsx"), &["kit/k6.ts"]));
+    }
+    let rules = layering(&mined(&repo(files)));
+    let kit: Vec<&str> = rules
+        .iter()
+        .filter(|(dir, _, _)| dir == "kit")
+        .map(|(_, s, _)| s.as_str())
+        .collect();
+    assert_eq!(kit, ["import:views"], "{rules:?}");
+}
