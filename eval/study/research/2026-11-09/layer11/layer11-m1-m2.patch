+/// A file's layering signals, each with the import's module (`import:app/board`,
+/// `app/board/board-context.ts`). Avoiding a *package* was accepted for 2 of 11
+/// proposals in the labelled evaluation (it mostly restates what a layer is), so only
+/// internal areas count.
+///
+/// A TypeScript/JavaScript import of a module in a two-segment area `p/x` also carries
+/// `import:p`, "imports from `p/**`", unless the file is itself in `p/**`: so a
+/// layering rule can be stated at the shallowest area where it holds
+/// ([`widen_layering`]), and `import:p` means the whole subtree its summary names.
+/// Python keeps `import:p` for the modules directly in `p`.
+fn layer_signals<'a>(
+    f: &'a FileFacts,
+    ctx: &'a RepoContext,
+) -> impl Iterator<Item = (String, &'a str)> + 'a {
+    let own = area(&f.path);
+    let subtree = f.lang != "py" && layer11_on("m1");
+    f.imports
+        .iter()
+        .filter(|i| !i.type_only)
+        .filter_map({
+            let own = own.clone();
+            move |i| {
+                let target = import_area(&i.module)?;
+                (target != own
+                    && !same_package(&f.package, &i.module)
+                    && !ctx.declares_module(&f.package, &i.module)
+                    && !(!i.load.is_static()
+                        && ctx.declares_optional_module(&f.package, &i.module)))
+                .then_some((target, i.module.as_str()))
+            }
+        })
+        .flat_map(move |(target, module)| {
+            let parent = subtree
+                .then(|| target.split_once('/').map(|(p, _)| p.to_string()))
+                .flatten()
+                .filter(|p| own != *p && !own.starts_with(&format!("{p}/")));
+            std::iter::once((format!("import:{target}"), module))
+                .chain(parent.map(|p| (format!("import:{p}"), module)))
+        })
+}
