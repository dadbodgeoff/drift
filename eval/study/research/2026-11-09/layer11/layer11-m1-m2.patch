+                .strip_prefix("import:")
+                .filter(|t| !t.contains('/') && !t.starts_with("pkg:"))
+                .map(str::to_string),
+            _ => None,
+        })
+        .collect();
+    drafts
+        .into_iter()
+        .filter(|d| match &d.rule {
+            Rule::Avoids { signal, .. } => !signal
+                .strip_prefix("import:")
+                .and_then(|t| t.split_once('/'))
+                .is_some_and(|(p, _)| !p.starts_with("pkg:") && wide.contains(p)),
+            _ => true,
+        })
+        .collect()
+}
