@@ -0,0 +1,312 @@
+//! Consumer-set comparability ([`drift_mine::mine`]'s `consumer_set_apart`, code
+//! `not_consumed`): a member of a rule's role that no file of the holders' consumers
+//! imports is another kind of member than the holders. It is set apart: listed as
+//! exempt, not an outlier, not counted in the evidence. The holders' consumers are the
+//! roles whose production files value-import at least the miner's bound (75%) of them,
+//! and what loads code from outside the facts (an entry point, a default export, a
+//! package entry). It fails closed: nothing is set apart with a file not parsed, when the
+//! holders have no consumer, under a guard rule, or for a member loaded from outside.
+//!
+//! The fixtures are generic services and controllers, not any dev repository's code.
+
+use drift_core::{
+    FileFacts, Import, ImportLoad, PackageFacts, RepoFacts, SkipReason, Skipped, Symbol,
+    SymbolKind, Wrap, WrapKind,
+};
+use drift_mine::mine::{Candidate, MineOptions, Rule, mine_unshown as mine};
+
+const PKG: &str = "web";
+const TRACED: &str = "web/src/lib/trace.ts#traced";
+const GUARD: &str = "web/src/lib/auth.ts#withAuth";
+
+fn sym(name: &str, exported: &str, wrapper: Option<&str>) -> Symbol {
+    Symbol {
+        name: name.into(),
+        kind: SymbolKind::Function,
+        exported_as: vec![exported.into()],
+        line: 1,
+        wraps: wrapper
+            .map(|w| {
+                vec![Wrap {
+                    wrapper: w.into(),
+                    kind: WrapKind::Call,
+                }]
+            })
+            .unwrap_or_default(),
+        ..Default::default()
+    }
+}
+
+fn file(path: &str, symbols: Vec<Symbol>, imports: Vec<Import>) -> FileFacts {
+    FileFacts {
+        path: path.into(),
+        package: PKG.into(),
+        lang: "ts".into(),
+        parse_ok: true,
+        symbols,
+        imports,
+        ..Default::default()
+    }
+}
+
+fn import(module: &str, name: &str) -> Import {
+    Import {
+        module: module.into(),
+        names: vec![name.into()],
+        type_only: false,
+        load: ImportLoad::Static,
+    }
+}
+
+/// How the fixture differs from the plain one.
+#[derive(Default, Clone, Copy)]
+struct Shape {
+    /// The wrapper is a guard (`withAuth`), not `traced`.
+    guard: bool,
+    /// No controller imports the holders: they have no consumer.
+    no_consumers: bool,
+    /// The lone helper is its file's default export.
+    default_export: bool,
+    /// A package entry exposes the lone helper.
+    public: bool,
+    /// One file was not parsed for lack of stack.
+    unparsed: bool,
+    /// Services the controllers do not import (the last ones), and outliers beside
+    /// `lazy` that a controller imports.
+    unimported: usize,
+    more_lazy: usize,
+    /// A controller imports `../services/helper`, which did not resolve.
+    unresolved: bool,
+    /// A controller's parse stopped early (`parse_ok` false).
+    parse_failed: bool,
+}
+
+/// 40 services in `web/src/services/`, `svcN = wrapper(...)`, each imported by its
+/// controller in `web/src/controllers/`; `lazy` (no wrapper, imported by a
+/// controller: a real outlier); `helper` (no wrapper, imported only by its own test file);
+/// plus 60 plain functions of another package, so the rule has lift.
+fn repo(shape: Shape) -> RepoFacts {
+    let wrapper = if shape.guard { GUARD } else { TRACED };
+    let svc = |n: &str| format!("web/src/services/{n}.ts");
+    let mut files = Vec::new();
+    let services = 40;
+    for i in 0..services {
+        let name = format!("svc{i}");
+        files.push(file(
+            &svc(&name),
+            vec![sym(&name, &name, Some(wrapper))],
+            vec![],
+        ));
+    }
+    let lazies: Vec<String> = std::iter::once("lazy".to_string())
+        .chain((0..shape.more_lazy).map(|i| format!("lazy{i}")))
+        .collect();
+    for l in &lazies {
+        files.push(file(&svc(l), vec![sym(l, l, None)], vec![]));
+    }
+    let exported = if shape.default_export {
+        "default"
+    } else {
+        "helper"
+    };
+    files.push(file(
+        &svc("helper"),
+        vec![sym("helper", exported, None)],
+        vec![],
+    ));
+    files.push(file(
+        "web/src/services/helper.test.ts",
+        vec![],
+        vec![import(&svc("helper"), exported)],
+    ));
+    for i in 0..40 {
+        let mut imports = Vec::new();
+        if !shape.no_consumers && i + shape.unimported < services {
+            imports.push(import(&svc(&format!("svc{i}")), &format!("svc{i}")));
+        }
+        if let Some(l) = lazies.get(i) {
+            imports.push(import(&svc(l), l));
+        }
+        if i == 1 && shape.unresolved {
+            imports.push(import("unresolved:../services/helper", "helper"));
+        }
+        let mut f = file(
+            &format!("web/src/controllers/c{i}.ts"),
+            vec![sym(&format!("ctrl{i}"), &format!("ctrl{i}"), None)],
+            imports,
+        );
+        f.parse_ok = !(i == 2 && shape.parse_failed);
+        files.push(f);
+    }
+    files.push(file(
+        "web/src/lib/trace.ts",
+        vec![sym("traced", "traced", None)],
+        vec![],
+    ));
+    files.push(file(
+        "web/src/lib/auth.ts",
+        vec![sym("withAuth", "withAuth", None)],
+        vec![],
+    ));
+    for i in 0..60 {
+        let mut f = file(
+            &format!("api/src/util/u{i}.ts"),
+            vec![sym(&format!("util{i}"), &format!("util{i}"), None)],
+            vec![],
+        );
+        f.package = "api".into();
+        files.push(f);
+    }
+    let mut r = RepoFacts {
+        files,
+        ..Default::default()
+    };
+    if shape.public {
+        r.packages.push(PackageFacts {
+            path: PKG.into(),
+            name: "web".into(),
+            entries: vec![svc("helper")],
+            ..Default::default()
+        });
+    }
+    if shape.unparsed {
+        r.skipped.push(Skipped {
+            path: "web/src/controllers/big.ts".into(),
+            reason: SkipReason::StackUnavailable,
+        });
+    }
+    r.normalize();
+    r
+}
+
+fn card(r: &RepoFacts, wrapper: &str) -> Candidate {
+    let rule = Rule::WrappedBy {
+        kind: WrapKind::Call,
+        any_of: vec![wrapper.into()],
+    };
+    let cs = mine(r, &MineOptions { max_per_repo: 200 }).candidates;
+    cs.iter()
+        .find(|c| c.rule == rule && c.role.package == PKG && c.role.dir.contains("services"))
+        .cloned()
+        .unwrap_or_else(|| {
+            panic!(
+                "{:?}",
+                cs.iter()
+                    .map(|c| (c.role.describe(), c.rule.describe()))
+                    .collect::<Vec<_>>()
+            )
+        })
+}
+
+fn outliers(c: &Candidate) -> Vec<&str> {
+    let mut v: Vec<&str> = c.outliers.iter().map(|o| o.symbol.as_str()).collect();
+    v.sort();
+    v
+}
+
+fn apart(c: &Candidate) -> Vec<&str> {
+    c.exempt
+        .iter()
+        .filter(|e| e.code == "not_consumed")
+        .map(|e| e.symbol.as_str())
+        .collect()
+}
+
+#[test]
+fn a_member_no_consumer_imports_is_set_apart() {
+    let c = card(&repo(Shape::default()), TRACED);
+    // `lazy` is imported where the services are: a real outlier.
+    assert_eq!(outliers(&c), vec!["lazy"]);
+    // `helper` is imported only by its test: another kind of member.
+    assert_eq!(apart(&c), vec!["helper"]);
+    assert_eq!((c.evidence.holders, c.evidence.total), (40, 41));
+    assert_eq!(c.evidence.role_members, Some(42));
+}
+
+#[test]
+fn holders_with_no_consumer_leave_the_role_untouched() {
+    let c = card(
+        &repo(Shape {
+            no_consumers: true,
+            ..Shape::default()
+        }),
+        TRACED,
+    );
+    assert_eq!(outliers(&c), vec!["helper", "lazy"]);
+    assert!(apart(&c).is_empty());
+}
+
+#[test]
+fn a_member_loaded_from_outside_is_comparable() {
+    for shape in [
+        Shape {
+            default_export: true,
+            ..Shape::default()
+        },
+        Shape {
+            public: true,
+            ..Shape::default()
+        },
+    ] {
+        let c = card(&repo(shape), TRACED);
+        assert_eq!(outliers(&c), vec!["helper", "lazy"]);
+        assert!(apart(&c).is_empty());
+    }
+}
+
+#[test]
+fn nothing_is_set_apart_under_a_guard_rule() {
+    let c = card(
+        &repo(Shape {
+            guard: true,
+            ..Shape::default()
+        }),
+        GUARD,
+    );
+    assert_eq!(outliers(&c), vec!["helper", "lazy"]);
+    assert!(apart(&c).is_empty());
+}
+
+#[test]
+fn an_import_graph_not_known_leaves_the_role_untouched() {
+    for shape in [
+        Shape {
+            unparsed: true,
+            ..Shape::default()
+        },
+        Shape {
+            parse_failed: true,
+            ..Shape::default()
+        },
+        Shape {
+            unresolved: true,
+            ..Shape::default()
+        },
+    ] {
+        let c = card(&repo(shape), TRACED);
+        assert_eq!(outliers(&c), vec!["helper", "lazy"]);
+        assert!(apart(&c).is_empty());
+    }
+}
+
+#[test]
+fn holders_set_apart_below_the_bound_drop_the_rule() {
+    // 40 services, 30 of them imported (75%), 4 imported outliers and the helper: 40/45
+    // passes the bound over the role; 30/34 over the comparable members does not.
+    let r = repo(Shape {
+        unimported: 10,
+        more_lazy: 3,
+        ..Shape::default()
+    });
+    let rule = Rule::WrappedBy {
+        kind: WrapKind::Call,
+        any_of: vec![TRACED.into()],
+    };
+    let cs = mine(&r, &MineOptions { max_per_repo: 200 }).candidates;
+    assert!(
+        !cs.iter()
+            .any(|c| c.rule == rule && c.role.dir.contains("services")),
+        "{:?}",
+        cs.iter().map(|c| c.role.describe()).collect::<Vec<_>>()
+    );
+}
