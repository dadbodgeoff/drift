+/// Consumer-set comparability: the members of a rule's role that are not comparable
+/// to its holders, with why. The holders' *consumers* are the roles whose production
+/// files value-import at least [`MIN_LOWER_BOUND`] of the holders (through re-exports;
+/// tests and type-only imports are no consumers), and, as one more consumer, what
+/// loads code from outside the facts, when it loads that share of them: an adapter's
+/// entry point, a file's default export (what a loader or runner picks up), a symbol a
+/// package entry exposes. A member is comparable when a file of a consumer role imports
+/// it, or when it is loaded from outside itself; otherwise it is another kind of
+/// member than the holders (a helper the route files export for their tests, a
+/// constant only its own file uses), and is set apart: listed, not an outlier, not
+/// counted. No name list and no new threshold: the share is the miner's own bound.
+///
+/// Fails closed: nothing is set apart when the facts do not say who imports what
+/// ([`RepoContext::imports_complete`]: a single-file scan, a file not parsed), when a
+/// member or holder is not a symbol the import graph has, when a relative import that
+/// did not resolve may point at a member's file ([`RepoContext::may_be_imported_unseen`]),
+/// or when the holders have no consumer. Never an entry point or a member under a guard rule (the gate every
+/// exemption keeps, [`Rule::exemption_allowed`]), and never a member loaded from outside.
+fn consumer_set_apart(
+    rule: &Rule,
+    population: &[usize],
+    holders: &BTreeSet<usize>,
+    units: &[Unit],
+    ctx: &RepoContext,
+) -> Vec<(usize, Exempted)> {
+    if !ctx.imports_complete() || holders.is_empty() || population.len() == holders.len() {
+        return vec![];
+    }
+    // Loaded by something outside the facts: an entry point, a default export, a
+    // symbol a package entry exposes.
+    let outside = |f: &FileFacts, s: &Symbol, public: bool| {
+        public || ctx.is_entry_unit(f, s) || s.exported_as.iter().any(|e| e == "default")
+    };
+    let mut views = Vec::with_capacity(population.len());
+    for &m in population {
+        let View::Symbol(f, s) = units[m].view else {
+            return vec![];
+        };
+        let Some(c) = ctx.consumers(&f.path, s) else {
+            return vec![];
+        };
+        if ctx.may_be_imported_unseen(&f.path) {
+            return vec![];
+        }
+        views.push((m, f, s, c));
+    }
+    // How many holders each role's files import, and how many are loaded from outside.
+    let mut by_role: BTreeMap<u32, usize> = BTreeMap::new();
+    let mut loaded = 0usize;
+    let mut held = 0usize;
+    for (m, f, s, c) in &views {
+        if !holders.contains(m) {
+            continue;
+        }
+        held += 1;
+        if outside(f, s, c.public) {
+            loaded += 1;
+        }
+        let roles: BTreeSet<u32> = c.files.iter().flat_map(|&fi| ctx.file_roles(fi)).collect();
+        for r in roles {
+            *by_role.entry(r).or_default() += 1;
+        }
+    }
+    if held != holders.len() {
+        return vec![];
+    }
+    let bar = MIN_LOWER_BOUND * held as f64;
+    let consumers: BTreeSet<u32> = by_role
+        .into_iter()
+        .filter(|&(_, k)| k as f64 >= bar)
+        .map(|(r, _)| r)
+        .collect();
+    if consumers.is_empty() && (loaded as f64) < bar {
+        return vec![];
+    }
+    let mut out = Vec::new();
+    for (m, f, s, c) in views {
+        if outside(f, s, c.public)
+            || c.files
+                .iter()
+                .any(|&fi| ctx.file_roles(fi).any(|r| consumers.contains(&r)))
+        {
+            continue;
+        }
+        let view = &units[m].view;
+        if !rule.exemption_allowed(view, ctx) {
+            continue;
+        }
+        let why = if c.files.is_empty() {
+            "imported by no production file, unlike the members that follow the rule".to_string()
+        } else {
+            "imported only outside the code that imports the members that follow the rule"
+                .to_string()
+        };
+        out.push((m, Exempted::new("not_consumed", why)));
+    }
+    out
+}
