diff --git a/crates/drift-core/src/trace.rs b/crates/drift-core/src/trace.rs
new file mode 100644
index 00000000..cebc623c
--- /dev/null
+++ b/crates/drift-core/src/trace.rs
@@ -0,0 +1,131 @@
+//! Opt-in hook trace for latency research (r13h). Off unless `DRIFT_HOOK_TRACE=<file>`
+//! is set; then `drift hook claude <Event>` appends one JSON line to that file at exit.
+//! Never fails a hook: write errors are ignored.
+
+use std::collections::BTreeMap;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+#[derive(Default)]
+struct Data {
+    ms: BTreeMap<String, f64>,
+    counts: BTreeMap<String, u64>,
+    path: Option<String>,
+    reason: Option<String>,
+    extra: BTreeMap<String, serde_json::Value>,
+}
+
+static T0: OnceLock<Instant> = OnceLock::new();
+static DATA: Mutex<Option<Data>> = Mutex::new(None);
+
+fn file() -> Option<String> {
+    static F: OnceLock<Option<String>> = OnceLock::new();
+    F.get_or_init(|| {
+        std::env::var("DRIFT_HOOK_TRACE")
+            .ok()
+            .filter(|s| !s.is_empty())
+    })
+    .clone()
+}
+
+pub fn on() -> bool {
+    file().is_some()
+}
+
+/// Call first thing in `main`.
+pub fn start() {
+    T0.get_or_init(Instant::now);
+}
+
+pub fn now() -> Instant {
+    Instant::now()
+}
+
+fn with(f: impl FnOnce(&mut Data)) {
+    if !on() {
+        return;
+    }
+    if let Ok(mut g) = DATA.lock() {
+        f(g.get_or_insert_with(Data::default));
+    }
+}
+
+/// Add the time since `t` to phase `name` (phases that run several times accumulate).
+pub fn add(name: &str, t: Instant) {
+    let ms = t.elapsed().as_secs_f64() * 1000.0;
+    with(|d| *d.ms.entry(name.to_string()).or_default() += ms);
+}
+
+pub fn count(name: &str) {
+    with(|d| *d.counts.entry(name.to_string()).or_default() += 1);
+}
+
+/// "fast", "fallback", "full" or "none".
+pub fn path(p: &str) {
+    with(|d| d.path = Some(p.to_string()));
+}
+
+/// Why the fast path was not taken; the first reason recorded wins (the innermost).
+pub fn reason(r: &str) {
+    with(|d| {
+        d.reason.get_or_insert_with(|| r.to_string());
+    });
+}
+
+pub fn set(key: &str, v: serde_json::Value) {
+    with(|d| {
+        d.extra.insert(key.to_string(), v);
+    });
+}
+
+/// Append the line. `total` is from `start()` to now.
+pub fn flush(event: &str, tool: Option<&str>, rel: Option<&str>, out: &str) {
+    let Some(f) = file() else { return };
+    let d = DATA
+        .lock()
+        .ok()
+        .and_then(|mut g| g.take())
+        .unwrap_or_default();
+    let mut ms = serde_json::Map::new();
+    for (k, v) in &d.ms {
+        ms.insert(k.clone(), serde_json::json!((v * 1000.0).round() / 1000.0));
+    }
+    if let Some(t0) = T0.get() {
+        ms.insert(
+            "total".into(),
+            serde_json::json!((t0.elapsed().as_secs_f64() * 1e6).round() / 1000.0),
+        );
+    }
+    // PLAN-R14 WS-D1 naming of the same fact.
+    let path = d.path.clone().unwrap_or_else(|| "none".into());
+    let r14 = match (path.as_str(), d.reason.as_deref()) {
+        ("fast", _) => "single_file".to_string(),
+        ("fallback" | "full", Some(r)) => format!("full_scan:{r}"),
+        ("fallback" | "full", None) => "full_scan".to_string(),
+        (_, Some(r)) => format!("skipped:{r}"),
+        _ => "skipped".to_string(),
+    };
+    let mut line = serde_json::json!({
+        "path_r14": r14,
+        "v": 1,
+        "event": event,
+        "tool": tool,
+        "rel": rel,
+        "path": path,
+        "reason": d.reason,
+        "out": out,
+        "ms": ms,
+        "counts": d.counts,
+    });
+    for (k, v) in d.extra {
+        line[k] = v;
+    }
+    use std::io::Write;
+    if let Ok(mut fh) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(f)
+    {
+        let _ = writeln!(fh, "{line}");
+    }
+}
