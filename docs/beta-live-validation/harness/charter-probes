#!/usr/bin/env python3
"""Extract the canonical probe and suspect manifest from the charter specs.

    charter-probes [--json] [NN ...]

Charters name their units in several schemes on purpose - P-05-01 numbered probes, P-03-a probe
classes, L1..L10 lifecycle steps in charter 09, C1..C7 per-cell steps in charter 10, S-NN-n
suspects everywhere. Completeness checking has to understand all of them, once, here - rather than
each consumer inventing its own regex and quietly missing a scheme.
"""
import json, os, re, sys
SPEC = os.environ.get("DRIFT_BETA_SPECS") or os.path.join(
    os.environ.get("DRIFT_BETA_SRC", "."), "docs/beta-live-validation")
if not os.path.isdir(SPEC):
    SPEC = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")

as_json = "--json" in sys.argv
want = [a for a in sys.argv[1:] if not a.startswith("--")]

# Repeated-unit schemes: a charter that says "for each of the 18 cells, do C1..C7" names 7 units,
# and each is run once per member of a set the charter defines.
REPEATED = {"09": ("L", 10, "per convention kind (23)"), "10": ("C", 7, "per ledger cell (18)")}

out = {}
for fn in sorted(os.listdir(SPEC)):
    m = re.match(r"^(\d{2})-(.+)\.md$", fn)
    if not m: continue
    nn, slug = m.group(1), m.group(2)
    if want and nn not in want: continue
    txt = open(os.path.join(SPEC, fn)).read()
    probes   = sorted(set(re.findall(r"\bP-%s-[0-9a-z]+\b" % nn, txt)))
    suspects = sorted(set(re.findall(r"\bS-%s-\d+\b" % nn, txt)))
    rep = {}
    if nn in REPEATED:
        pfx, n, over = REPEATED[nn]
        found = sorted(set(re.findall(r"\b%s\d+\b" % pfx, txt)),
                       key=lambda x: int(x[len(pfx):]))
        rep = {"prefix": pfx, "units": found, "expected": n, "repeated_over": over}
    out[nn] = {"file": fn, "slug": slug, "probes": probes, "suspects": suspects,
               "repeated": rep,
               "probe_count": len(probes), "suspect_count": len(suspects)}

if as_json:
    print(json.dumps(out, indent=1)); sys.exit(0)
tp = ts = 0
for nn, c in out.items():
    extra = ""
    if c["repeated"]:
        r = c["repeated"]
        extra = f"  + {len(r['units'])} {r['prefix']}-steps {r['repeated_over']}"
    print(f"  {nn}  probes={c['probe_count']:>3}  suspects={c['suspect_count']:>2}{extra}   {c['slug']}")
    tp += c["probe_count"]; ts += c["suspect_count"]
print(f"\n  {len(out)} charters · {tp} named probes · {ts} suspects")
