  "conventions": [
    {
      "id": "convention_572bf7b306010298",
      "kind": "api_route_no_direct_data_access",
      "statement": "API routes should not import data-access clients directly.",
      "severity": "error",
      "enforcement_mode": "warn",
      "enforcement_capability": "deterministic_check",
      "scope": {
        "path_globs": [
          "**/app/**/route.ts",
          "**/app/**/route.tsx",
          "**/app/**/route.js",
          "**/app/**/route.jsx",
          "**/pages/api/**/*.ts",
          "**/pages/api/**/*.tsx",
          "**/pages/api/**/*.js",
          "**/pages/api/**/*.jsx"
        ],
        "file_roles": [
          "api_route"
        ]
      },
      "matcher": {
        "kind": "api_route_no_direct_data_access",
        "forbidden_imports": [
          "@/lib/db"
        ],
        "applies_to_file_roles": [
          "api_route"
        ]
      },
      "exceptions": [],
      "agent_instruction": "When editing API route files, do not import data-access clients directly. Forbidden imports: @/lib/db. Delegate through the repo's accepted service/data-access layer and run drift check before finishing.",
      "conforming_examples": [
        {
          "file_path": "app/api/og/route.tsx",
          "role": "api_route"
        },
        {
          "file_path": "app/api/users/stripe/route.ts",
          "role": "api_route"
        },
        {
          "file_path": "pages/api/auth/[...nextauth].ts",
          "role": "api_route"
        }
      ],
      "conforming_examples_reason": null,
      "rationale": {
        "derivation": "Detected API route imports that look like database/data-access clients.",
        "reason": "Route modules are transport: they parse a request, delegate, and serialize a response. Reaching into the data layer from a route couples the HTTP surface to storage, so auth, validation, and query shape stop being enforceable in one place."
      },
      "migration_sentence": "4 existing violations are baselined and do not block; new code is held to this rule."
    }
  ],
